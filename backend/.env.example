# SHADDAI Backend Configuration
# Copy this file to .env and update with your values

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development
# Values: development, staging, production

# ============================================
# SERVER
# ============================================
PORT=3000
HOST=0.0.0.0
# For production, use specific IP or domain

# ============================================
# DATABASE — File Storage (Default)
# ============================================
# No configuration needed for development
# Data stored in ./data/ directory

# ============================================
# DATABASE — PostgreSQL (Production)
# ============================================
DB_TYPE=file
# Values: file (default), postgresql

# PostgreSQL connection (only if DB_TYPE=postgresql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shaddai_prod
DB_USER=shaddai_user
DB_PASSWORD=your_secure_password_here
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=30000

# ============================================
# CACHING — Redis (Optional)
# ============================================
CACHE_ENABLED=true
# Values: true, false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Leave empty if no password
REDIS_DB=0
REDIS_POOL_MIN=2
REDIS_POOL_MAX=10

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=your_very_long_random_secret_string_here_change_this_in_production
# Minimum 32 characters recommended

JWT_EXPIRY=24h
# Values: 24h, 7d, 30d, 90d

JWT_REFRESH_SECRET=another_very_long_random_secret_for_refresh_tokens
JWT_REFRESH_EXPIRY=7d

# ============================================
# CORS — Cross-Origin Resource Sharing
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
# Comma-separated list of allowed origins
# For production: https://yourdomain.com,https://www.yourdomain.com

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
# Time window in milliseconds (60000 = 1 minute)

RATE_LIMIT_MAX_REQUESTS=1000
# Max requests per window per IP

RATE_LIMIT_SKIP_HEALTH=true
# Skip rate limiting for health checks

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
# Values: debug, info, warn, error

LOG_FORMAT=json
# Values: json, text

LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs
LOG_RETENTION_DAYS=30
# Delete logs older than this many days

# ============================================
# PERFORMANCE
# ============================================
MAX_REQUEST_SIZE=50mb
# Max payload size

REQUEST_TIMEOUT=30000
# Request timeout in milliseconds

COMPRESSION_ENABLED=true
# Enable gzip compression

COMPRESSION_LEVEL=6
# Compression level 1-9 (higher = slower but better compression)

# ============================================
# CACHING STRATEGY
# ============================================
CACHE_TTL_HEALTH=5000
# Time-to-live in milliseconds (5 seconds)

CACHE_TTL_STATUS=10000
# 10 seconds

CACHE_TTL_AGENTS=30000
# 30 seconds

CACHE_TTL_JOBS=20000
# 20 seconds

CACHE_TTL_ANALYTICS=60000
# 60 seconds

# ============================================
# WEBSOCKET
# ============================================
WEBSOCKET_ENABLED=true
WEBSOCKET_PING_INTERVAL=30000
# Send ping every 30 seconds

WEBSOCKET_PING_TIMEOUT=5000
# Wait 5 seconds for pong

# ============================================
# BATCH PROCESSING
# ============================================
BATCH_ENABLED=true
BATCH_MAX_CONCURRENT=10
# Max parallel jobs

BATCH_QUEUE_SIZE=1000
# Max queued jobs

# ============================================
# SKILL EXECUTION
# ============================================
EXECUTOR_TIMEOUT=120000
# Execution timeout in milliseconds (120 seconds)

EXECUTOR_MAX_RETRIES=3
# Max retry attempts on failure

EXECUTOR_RETRY_DELAY=1000
# Initial retry delay (exponential backoff)

# ============================================
# MONITORING — Sentry (Error Tracking)
# ============================================
SENTRY_ENABLED=false
SENTRY_DSN=https://your-sentry-key@sentry.io/your-project-id
# Enable in production for error tracking

# ============================================
# MONITORING — New Relic
# ============================================
NEW_RELIC_ENABLED=false
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
NEW_RELIC_APP_NAME=SHADDAI Backend

# ============================================
# MONITORING — Datadog
# ============================================
DATADOG_ENABLED=false
DATADOG_API_KEY=your_datadog_api_key
DATADOG_ENVIRONMENT=production

# ============================================
# BACKUP & RECOVERY
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
# Cron format: minute hour day month day-of-week
# 0 2 * * * = daily at 2 AM

BACKUP_RETENTION_DAYS=30
# Keep backups for 30 days

BACKUP_DESTINATION=./backups
# Local path or S3 bucket (s3://bucket-name)

# ============================================
# S3 BACKUP (if using S3)
# ============================================
AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=shaddai-backups

# ============================================
# FEATURES
# ============================================
FEATURES_JOB_MARKETPLACE=true
FEATURES_REAL_TIME_UPDATES=true
FEATURES_BATCH_JOBS=true
FEATURES_ANALYTICS=true
FEATURES_DATA_EXPORT=true

# ============================================
# DEVELOPMENT ONLY
# ============================================
DEBUG=false
# Set to true for verbose logging

MOCK_AGENTS=false
# Set to true to mock agent responses

SEED_DATABASE=false
# Set to true to load sample data on startup

# ============================================
# SECURITY
# ============================================
SECURE_HEADERS_ENABLED=true
# Enable security headers (Helmet.js)

HELMET_CSP_ENABLED=false
# Content Security Policy (requires configuration)

API_KEY_REQUIRED=false
# Set to true to require API key authentication

# ============================================
# EMAIL NOTIFICATIONS
# ============================================
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@example.com

# ============================================
# INTEGRATIONS
# ============================================
# Add integration keys as needed
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
GITHUB_TOKEN=
SLACK_WEBHOOK_URL=

# ============================================
# SYSTEM
# ============================================
TIMEZONE=UTC
# Set your timezone

LANGUAGE=en
# Default language code

# ============================================
# MAINTENANCE
# ============================================
MAINTENANCE_MODE=false
# Set to true to enable maintenance mode

MAINTENANCE_MESSAGE=Server is under maintenance
SCHEDULED_CLEANUP_ENABLED=true
CLEANUP_SCHEDULE=0 3 * * *
# Daily cleanup at 3 AM

# ============================================
# NOTES
# ============================================
# 1. Copy this file to .env
# 2. Update values for your environment
# 3. Never commit .env to version control
# 4. Use strong random values for secrets
# 5. Update ALLOWED_ORIGINS for production
# 6. Use PostgreSQL in production (not file storage)
# 7. Enable monitoring services (Sentry, etc.)
# 8. Configure SSL certificates
# 9. Set up automated backups
# 10. Test all configurations before deploying
