tor":{"hints":0.06534069387709746,"nudge":0.07484158416912888,"direction":0.06228209036564995,"don":0.07082930374649489,"bogged":0.07484158416912888,"down":0.03916680995215389,"trying":0.04197390388767125,"nail":0.07484158416912888,"every":0.032788128331218906,"requirement":0.1245641807312999,"still":0.03448249089539957,"need":0.09894737358265179,"move":0.05147479417970267,"actually":0.020165029368091066,"answering":0.06928391962482482,"question":0.04261154849956112,"next":0.03216498069297902,"estimate":0.05028213904076199,"amount":0.10294958835940533,"data":0.12490800301684075,"re":0.03632264434925856,"dealing":0.07484158416912888,"some":0.0693863254480325,"quick":0.04261154849956112,"calculations":0.06534069387709746,"example":0.08074604715400736,"calculate":0.07484158416912888,"storage":0.09444707105862897,"size":0.06228209036564995,"bandwidth":0.05767010333589659,"requirements":0.15084641712228597,"help":0.040221706270139615,"choose":0.11167960717013209,"components":0.09837000533365223,"give":0.028686439693648216,"idea":0.04078124874873057,"scaling":0.11167960717013209,"look":0.06432996138595803,"like":0.04644213093401022,"later":0.08944894899291589,"make":0.023773924216558825,"assumptions":0.11167960717013209,"volume":0.06928391962482482,"typical":0.06534069387709746,"behavior":0.06228209036564995,"always":0.03216498069297902,"check":0.04197390388767125,"interviewer":0.17934908799838023,"match":0.06228209036564995,"expectations":0.06534069387709746,"alright":0.1306813877541949,"step":0.14735209200401286,"design":0.20689494537239742,"system":0.22980267360287554,"high":0.08796676237486196,"level":0.0839478077753425,"where":0.021637426610571147,"lay":0.06228209036564995,"most":0.091348150792051,"fundamental":0.05767010333589659,"pieces":0.11956605866558681,"illustrate":0.06534069387709746,"work":0.029922130620872622,"together":0.03866832275183376,"achieve":0.06228209036564995,"desired":0.06928391962482482,"functionality":0.059783029332793405,"keeping":0.0597830293