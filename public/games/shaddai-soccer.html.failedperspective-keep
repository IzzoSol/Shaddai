// ------------------------------------------------------------------
// CANVAS / FIELD SETUP
// ------------------------------------------------------------------
const cv = document.getElementById('cv');
const ctx = cv.getContext('2d');

// Logical field dimensions (the PHYSICS world lives in these units — unchanged).
//  field X : 0 (left goal) .. FIELD.w (right goal)   → screen WIDTH axis
//  field Y : 0 (FAR touchline / horizon) .. FIELD.h (NEAR touchline / bottom) → screen DEPTH axis
// Regulation pitch is ~1.575:1 (105m x 68m). 1040/660 = 1.576 — proportions are true-to-life.
const FIELD = { w: 1040, h: 660, margin: 46 };
let scale = 1;               // legacy uniform scale, kept ONLY for HUD text sizing (screen px per ~ref px)

// ------------------------------------------------------------------
// PERSPECTIVE PROJECTION  (2.5D broadcast pitch on a flat 2D canvas)
// ------------------------------------------------------------------
// A single proj(fx,fy) maps field coords → screen {x,y,s}. It is the ONE
// source of truth: field lines, players, ball, goals all route through it so
// nothing can drift out of alignment. Nearer (large fy) → bigger & lower on
// screen; farther (small fy) → smaller & higher, receding to a vanishing line.
//
// MATH — a pinhole-style depth divide (same family as football.html):
//   dz = distance of the point from the camera along the depth axis
//   s  = CAMD / (CAMD + dz)                (perspective foreshortening 0..1)
//   screenY = horizonY + (baseY - horizonY) * s
//   screenX = cx + (fx - FIELD.w/2) * PPX * s
// s falls off as 1/(1+dz) — the exact hyperbolic falloff of true perspective,
// so a straight field line stays straight and evenly-mapped (not warped).
// SACRED-GEOMETRY FRAMING — the pitch is composed on the golden ratio (φ≈1.618).
//  horizonFrac = 1 - 1/φ  ≈ 0.382  → the vanishing horizon sits on the upper golden
//  section, so the playable turf occupies the lower 1/φ (≈0.618) of the frame — the
//  classic golden division. camd is tuned so the FAR touchline projects right onto
//  that horizon (pitch fills the frame, no dead band), while the falloff stays a true
//  1/(1+dz) hyperbola (mathematically-correct perspective, not a warp).
const PERSP = {
  camd: 300,        // camera-distance constant (larger = gentler/flatter perspective)
  camBehind: 92,    // how far behind the near touchline the camera plane sits (depth units)
  horizonFrac: 0.382,// φ: vanishing horizon on the upper golden section (1 - 1/φ)
  baseFrac: 0.975,  // fraction of screen height where the near touchline sits
  fillFrac: 0.985   // horizontal fill of the near plane across the viewport
};
let horizonY = 0, baseY = 0, PPX = 0;   // recomputed on resize (screen-space)
let camFlip = 1;                        // +1 default, -1 OPPONENT VIEW (mirror depth+width)
let camZoomP = 1, camPanX = 0, camPanY = 0; // CHASE-cam zoom/pan (screen space, applied post-proj)

function resize(){
  const W = window.innerWidth, Hh = window.innerHeight;
  cv.width = Math.floor(W); cv.height = Math.floor(Hh);
  horizonY = Hh * PERSP.horizonFrac;
  baseY    = Hh * PERSP.baseFrac;
  // px-per-field-unit of WIDTH at the near plane (s≈1): fill fillFrac of the viewport.
  PPX = (W * PERSP.fillFrac) / FIELD.w;
  scale = Math.min(W/1132, Hh/752);   // HUD text scale reference (old canvas ~ 1132x752)
}
window.addEventListener('resize', resize);
resize();

// Project a field point → screen. s = depth scale (also used to size players/ball).
function proj(fx, fy){
  // depth from camera: near touchline (fy=FIELD.h) is closest, far (fy=0) recedes.
  let depth = (FIELD.h - fy);                 // 0 at near touchline, FIELD.h at far
  let dz = (depth + PERSP.camBehind);         // distance from camera plane
  if(camFlip < 0) dz = (fy + PERSP.camBehind); // OPPONENT VIEW: mirror the depth axis
  if(dz < 1) dz = 1;
  const s = PERSP.camd / (PERSP.camd + dz);
  let sy = horizonY + (baseY - horizonY) * s;
  let sx = cv.width/2 + (fx - FIELD.w/2) * camFlip * PPX * s;
  // CHASE cam: zoom about the focus (camPanX/Y is the screen-space focus point)
  if(camZoomP !== 1){
    sx = cv.width/2 + (sx - camPanX) * camZoomP;
    sy = cv.height/2 + (sy - camPanY) * camZoomP;
  }
  return { x: sx + shakeX, y: sy + shakeY, s: s * (camZoomP!==1?camZoomP:1) };
}
function projS(fx,fy){ return proj(fx,fy).s; }

