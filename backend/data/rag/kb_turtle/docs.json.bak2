":0.10618623345852508,"extraordinary":0.056672107656114065,"protean":0.061716412053348386,"figure":0.033070445045756805,"painter":0.04613105680500552,"sculptor":0.056672107656114065,"draftsman":0.056672107656114065,"printmaker":0.061716412053348386,"late":0.0444698214051767,"medical":0.061716412053348386,"case":0.10618623345852508,"historical":0.056672107656114065,"critical":0.05309311672926254,"simply":0.05031703569392849,"able":0.09921133513727043,"paint":0.12901352380438177,"anymore":0.040508006876444506,"therapeutic":0.061716412053348386,"purposes":0.05309311672926254,"pictures":0.10618623345852508,"full":0.03750776148091967,"tricks":0.061716412053348386,"mannerisms":0.061716412053348386,"dependent":0.061716412053348386,"entirely":0.05031703569392849,"references":0.0444698214051767,"people":0.018030028825872048,"his":0.1270987932645296,"own":0.02575791728662224,"earlier":0.048048812332028235,"her":0.03438121261070808,"biography":0.061716412053348386,"granddaughter":0.061716412053348386,"marina":0.061716412053348386,"stated":0.056672107656114065,"family":0.03584652608109086,"escape":0.056672107656114065,"stranglehold":0.061716412053348386,"genius":0.0394255170079424,"wrote":0.0444698214051767,"hundreds":0.05031703569392849,"poems":0.11334421531222813,"throughout":0.05031703569392849,"life":0.022440847305543108,"often":0.03842972285892662,"incorporating":0.05309311672926254,"experimental":0.061716412053348386,"techniques":0.05031703569392849,"some":0.02094615770486374,"were":0.04889429944334193,"even":0.02298183625128819,"published":0.061716412053348386,"literary":0.056672107656114065,"journals":0.061716412053348386,"anthologies":0.061716412053348386,"following":0.04613105680500552,"death":0.03370857391370056,"mother":0.043004507934793934,"maria":0.05031703569392849,"attention":0.03664943597260834,"shattered":0.061716412053348386,"thanks":0.048048812332028235,"incoming":0.061716412053348386,"threat":0.061716412053348386,"second":0.04613105680500552,"world":0.04008194838476082,"war":0.16203202750577803,"decision":0.0444698214051767,"stay":0.05031703569392849,"paris":0.03509230817110554,"during":0.06876242522141617,"tumultuous":0.061716412053348386,"period":0.03664943597260834,"source":0.0394255170079424,"controversy":0.061716412053348386,"debate":0.061716412053348386,"being":0.07832515536449934,"outspoken":0.061716412053348386,"promoted":0.061716412053348386,"liberty":0.061716412053348386,"under":0.056672107656114065,"surveillance":0.061716412053348386,"nazis":0.12343282410669677,"though":0.03370857391370056,"watched":0.05031703569392849,"continued":0.03842972285892662,"resist":0.05309311672926254,"alongside":0.0394255170079424,"fellow":0.04169374036984264,"parisians":0.05309311672926254,"signing":0.05309311672926254,"partitions":0.05309311672926254,"against":0.0394255170079424,"fascism":0.043004507934793934,"oppression":0.05309311672926254,"taking":0.043004507934793934,"part":0.033070445045756805,"secret":0.048048812332028235,"resistance":0.048048812332028235,"gatherings":0.05309311672926254,"opposed":0.05031703569392849,"nazi":0.05309311672926254,"atrocities":0.056672107656114065,"ii":0.061716412053348386,"famous":0.08600901586958787,"anti":0.05031703569392849,"guernica":0.10063407138785697,"kept":0.05309311672926254,"hidden":0.061716412053348386,"parisian":0.056672107656114065,"apartment":0.05309311672926254,"protect":0.056672107656114065,"confiscated":0.061716412053348386,"destroyed":0.061716412053348386,"eventually":0.03842972285892662,"unveiled":0.061716412053348386,"public":0.043004507934793934,"after":0.03080222168385655,"ended":0.05031703569392849,"probably":0.03246345708368537,"most":0.02217892635977071,"image":0.048048812332028235,"20th":0.043004507934793934,"century":0.04169374036984264,"shown":0.056672107656114065,"whitechapel":0.061716412053348386,"gallery":0.04613105680500552}},{"id":"doc_1785212350223_0j82g0_c12","text":"in 1939 to alert the world to the brutalities of fascism. Picasso was responding in his own visceral way to the horrors of war, flailing bulls and [music] horses and people. He never visited Guernica itself, the Basque town obliterated by German bombers in the Spanish Civil War. This is a tapestry version &gt;&gt; [music] &gt;&gt; borrowed for a year from the United Nations, not the original painting. But its presence still seems just as political [music] on the eve of the G20 summit. &gt;&gt; Guernica is striking not only for its subject matter, but also for its monumental size. Measuring 3.49 m tall and 7.76 m wide, the painting is rendered in a stark monochromatic palette of black, white, and grays, which enhances [music] its dramatic impact and evokes the feel of newspaper photographs, contemporary accounts of the bombing, and perhaps film reels [music] of the era. This choice of color, or the absence of it, might also symbolize the reduction of life to mere shadows during such catastrophic [music] events. Guernica is dense with symbols. At the center of the canvas, a gored horse falls in agony, often interpreted as a symbol of the people of Spain themselves. Beneath the horse lies a dismembered [music] soldier, his broken sword nearby symbolizing the defeat and the fallen broken spirit of the people. Initially [music] displayed at the Spanish Pavilion of the 1937 World's Fair in Paris, it became a touring [music] exhibition to raise awareness and funds for Spanish war relief. The painting's [music] stark depiction of suffering and chaos makes it an eternal reminder of the tragedies of war, influencing [music] many artists and becoming a universal symbol of protest against military aggression. Into his later years, he continued to display the state of all things, from windows into the human condition to the state of the world. He fell in love once again, marrying Jacqueline Roque in Vallauris, shortly before developing a unique free-standing sculpture, The Woman with Outstretched Arms. This monochromatic sculpture was a playful addition to many black and white works Picasso had developed since 1904. The art piece was inspired by his childhood, as Picasso would often cut pieces of paper and shape them into animals for his sisters [music] to enjoy. This reference to his childhood was adored by many. The pieces were built from sheet metal Picasso had acquired from a scrap shop [music] not far from his home in southern France. This was one of 120 figures he created, [music] most of which featured nude females, with some animals such as owls, bulls, and monkeys, &gt;&gt; [music] [music] &gt;&gt; Pablo Picasso [music] produced around 13,500 paintings in his impressive 78-year career. &gt;&gt; [music] &gt;&gt; Many of his works depicted the artist's emotions during [music] the time of their creation, often encapsulating his feelings during the sociopolitical conflict, at times capturing his loneliness and depression. In other instances, [music] his joy and spurs of imagination. His last painting was aptly named self-portrait","t0":2400,"t1":2600,"tsReal":false,"tfIdfVector":{"13":0.03634164132984651,"49":0.047632336272277476,"76":0.050843217641561696,"78":0.050843217641561696,"120":0.050843217641561696,"500":0.04138634432663635,"1904":0.050843217641561696,"1937":0.047632336272277476,"1939":0.05536870075708514,"alert":0.05536870075708514,"world":0.05393910627755817,"brutalities":0.05536870075708514,"fascism":0.0385813700412306,"picasso":0.11711531138536314,"responding":0.05536870075708514,"his":0.2470570161628272,"own":0.023108641071615255,"visceral":0.05536870075708514,"way":0.019004385858679015,"horrors":0.043106853156754034,"war":0.14536656531938605,"flailing":0.05536870075708514,"bulls":0.10168643528312339,"music":0.45605670477558435,"horses":0.05536870075708514,"people":0.04852676480147876,"he":0.06026588301588617,"never":0.02193268973790607,"visited":0.03989597178746979,"guernica":0.1354253495769872,"itself":0.03634164132984651,"basque":0.047632336272277476,"town":0.035370488671946365,"obliterated":0.047632336272