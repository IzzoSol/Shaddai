function postScore(score){
  const pickedIds = skillPicked.map(i=>ALL_SKILL_DEFS[i] && ALL_SKILL_DEFS[i].id).filter(Boolean);
  try{
    window.parent.postMessage({type:'shaddai-game-score', game:'soccer', score:score}, '*');
  }catch(e){}
  // FRANCHISE HOOK (out): structured match result for a future franchise layer.
  // No-op-safe — just an extra postMessage nobody has to listen to.
  try{
    window.parent.postMessage({
      type:'shaddai-soccer-result',
      game:'soccer',
      captain:selectedAgent.id,
      you:scoreYou, opp:scoreOpp,
      win: scoreYou>scoreOpp, draw: scoreYou===scoreOpp,
      teamSize:teamSize, skills:pickedIds
    }, '*');
  }catch(e){}
  try{
    fetch('/api/leaderboard/soccer', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({ game:'soccer', captain:selectedAgent.id, score:score, opponent:scoreOpp, skills:pickedIds })
    }).catch(()=>{});
  }catch(e){}
}

// ------------------------------------------------------------------
// PARTICLES
// ------------------------------------------------------------------
// particles live in FIELD space (fx,fy) so they project correctly in perspective.
function spawnKickParticles(x,y,color){
  let n=8;
  if(particles.length+n>MAX_PARTICLES) n=Math.max(0, MAX_PARTICLES-particles.length);
  for(let i=0;i<n;i++){
    const a=Math.random()*Math.PI*2, s=18+Math.random()*40;   // field-units/sec
    particles.push({fx:x,fy:y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:0.4+Math.random()*0.3,color});
  }
}
// confetti bursts at field-center; x/y are small screen-space offsets around the projected point.
function spawnConfetti(color){
  const cols=[color,'#2de6ff','#ffd35c','#38ffb0','#ffffff'];
  for(let i=0;i<70;i++){
    confetti.push({
      fx:FIELD.w/2, fy:FIELD.h*0.55,
      x:(Math.random()-0.5)*260, y:-40-Math.random()*90,
      vx:(Math.random()-0.5)*10, vy:-4-Math.random()*7,
      rot:Math.random()*6, vr:(Math.random()-0.5)*0.4,
      w:4+Math.random()*5, h:6+Math.random()*7,
      color:cols[(Math.random()*cols.length)|0], life:1.4+Math.random()*1.2
    });
  }
}

// ------------------------------------------------------------------
// CAMERA
// ------------------------------------------------------------------
// Update smoothed camera each frame (called from update()). The perspective
// is applied inside proj(); here we only smooth the CHASE zoom/pan + view flip.
//  view 0 SIDELINE : full broadcast pitch, no flip, no zoom
//  view 1 OPPONENT : depth axis mirrored (camFlip=-1) → you look back from the far end
//  view 2 CHASE    : zoom in on the controlled player (screen-space zoom about focus)
function updateCamera(dt){
  if(viewFlash>0) viewFlash = Math.max(0, viewFlash - dt);
  // view flip is instantaneous (proj reads camFlip); zoom/pan smooth toward target
  let tZ, tPX, tPY;
  if(cameraView===2 && (userControlled || watchOn)){
    const fp = userControlled || ballOwner || {x:ball.x, y:ball.y};
    const fx = fp.x*0.55 + ball.x*0.45;
    const fy = fp.y*0.55 + ball.y*0.45;
    const sp = proj(fx, fy);   // note: proj uses current camZoomP; fine as a target seed
    tZ = 1.9;
    tPX = sp.x; tPY = sp.y;
  } else {
    tZ = 1; tPX = cv.width/2; tPY = cv.height/2;
  }
  const k = Math.min(1, dt*8);
  camZoomP += (tZ - camZoomP)*k;
  camPanX  += (tPX - camPanX)*k;
  camPanY  += (tPY - camPanY)*k;
  if(Math.abs(camZoomP-1) < 0.004) camZoomP = 1;   // snap to identity to avoid drift
  camFlip = (cameraView===1) ? -1 : 1;
}

// ------------------------------------------------------------------
// RENDER
// ------------------------------------------------------------------
function draw(){
  ctx.setTransform(1,0,0,1,0,0);
  ctx.clearRect(0,0,cv.width,cv.height);

  shakeX = shake>0 ? (Math.random()-0.5)*shake : 0;
  shakeY = shake>0 ? (Math.random()-0.5)*shake : 0;

  // ALL world art is drawn directly in SCREEN space via proj() — no ctx transform.
  drawPitch();
  drawGoalNet('far');      // far goal net behind everything

  // ball ground shadow (projected; foreshortened ellipse at the ball's field pos)
  {
    const bp = proj(ball.x, ball.y);
    ctx.save();
    ctx.fillStyle='rgba(0,0,0,0.32)';
    ctx.beginPath();
    ctx.ellipse(bp.x+4*bp.s, bp.y+3*bp.s, BALL_R*bp.s*0.95, BALL_R*bp.s*0.5, 0,0,Math.PI*2);
    ctx.fill(); ctx.restore();
  }
  // ball trail (projected)
  for(let i=0;i<ball.trail.length;i++){
    const t=ball.trail[i], tp=proj(t.x,t.y), al=i/ball.trail.length*0.35;
    ctx.fillStyle=`rgba(255,255,255,${al})`;
    ctx.beginPath(); ctx.arc(tp.x,tp.y,BALL_R*tp.s*(i/ball.trail.length),0,Math.PI*2); ctx.fill();
  }

  // DEPTH SORT — draw far (small field-y) first so nearer players overlap them.
  // OPPONENT view mirrors the depth axis, so the order flips.
  drawOrder.length = 0;
  for(let i=0;i<players.length;i++) drawOrder[i]=players[i];
  drawOrder.sort(cameraView===1 ? sortByYDesc : sortByYAsc);
  // interleave the ball by its own depth so it can sit in front of / behind bodies
  const ballDepth = ball.y;
  let ballDrawn = false;
  for(let i=0;i<drawOrder.length;i++){
    const pd = drawOrder[i].y;
    const nearer = cameraView===1 ? (pd < ballDepth) : (pd > ballDepth);
    if(!ballDrawn && nearer){ drawBall(); ballDrawn = true; }
    drawPlayer(drawOrder[i]);
  }
  if(!ballDrawn) drawBall();

  drawGoalNet('near');     // near goal posts drawn over players for depth

  // particles (projected)
  for(const pt of particles){
    const pp = proj(pt.fx!==undefined?pt.fx:pt.x, pt.fy!==undefined?pt.fy:pt.y);
    ctx.globalAlpha=Math.max(0,pt.life);
    ctx.fillStyle=pt.color;
    ctx.beginPath(); ctx.arc(pp.x,pp.y,2.4*pp.s,0,Math.PI*2); ctx.fill();
  }
  ctx.globalAlpha=1;

  // confetti (projected to the field center burst)
  for(const c of confetti){
    const cp = proj(c.fx!==undefined?c.fx:FIELD.w/2, c.fy!==undefined?c.fy:FIELD.h/2);
    ctx.save();
    ctx.globalAlpha=Math.min(1,c.life);
    ctx.translate(cp.x + (c.x||0)*cp.s, cp.y + (c.y||0)*cp.s); ctx.rotate(c.rot);
    ctx.fillStyle=c.color; ctx.fillRect(-c.w/2*cp.s,-c.h/2*cp.s,c.w*cp.s,c.h*cp.s);
    ctx.restore();
  }
  ctx.globalAlpha=1;

  drawHUD();

  if(state==='celebrate'){
    ctx.save();
    ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.font='900 '+Math.floor(64*scale)+'px Segoe UI, sans-serif';
    ctx.fillStyle=celebrateColor;
    ctx.shadowColor=celebrateColor; ctx.shadowBlur=30;
    ctx.fillText(celebrateText, cv.width/2, cv.height/2);
    ctx.restore();
  }
}

// helper: stroke a straight field line between two field points (perspective-correct
// because both endpoints are individually projected — a straight line stays straight).
function fLine(x0,y0,x1,y1){
  const a=proj(x0,y0), b=proj(x1,y1);
  ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
}
// fill a field-space quad (4 corners) — used for the pitch body and mow stripes.
function fQuad(pts, style){
  ctx.fillStyle=style; ctx.beginPath();
  const p0=proj(pts[0][0],pts[0][1]); ctx.moveTo(p0.x,p0.y);
  for(let i=1;i<pts.length;i++){ const p=proj(pts[i][0],pts[i][1]); ctx.lineTo(p.x,p.y); }
  ctx.closePath(); ctx.fill();
}
// draw a field-space arc (circle/penalty arc) by sampling points and projecting each.
function fArc(cx,cy,r,a0,a1){
  ctx.beginPath();
  const N=40;
  for(let i=0;i<=N;i++){
    const a=a0+(a1-a0)*i/N;
    const p=proj(cx+Math.cos(a)*r, cy+Math.sin(a)*r);
    if(i===0) ctx.moveTo(p.x,p.y); else ctx.lineTo(p.x,p.y);
  }
  ctx.stroke();
}

function drawPitch(){
  const W=cv.width, Hh=cv.height;
  // --- sky / stands haze above the horizon ---
  const sky=ctx.createLinearGradient(0,0,0,horizonY+40);
  sky.addColorStop(0,'#05070d'); sky.addColorStop(0.6,'#081522'); sky.addColorStop(1,'#0c2033');
  ctx.fillStyle=sky; ctx.fillRect(0,0,W,horizonY+40);
  // horizon glow so far touchline separates from the stands
  const hg=ctx.createLinearGradient(0,horizonY-30,0,horizonY+30);
  hg.addColorStop(0,'rgba(45,230,255,0)'); hg.addColorStop(0.5,'rgba(45,230,255,0.14)'); hg.addColorStop(1,'rgba(45,230,255,0)');
  ctx.fillStyle=hg; ctx.fillRect(0,horizonY-30,W,60);
  // ground fill below (dark base beneath the trapezoid)
  ctx.fillStyle='#061019'; ctx.fillRect(0,horizonY,W,Hh-horizonY);

  // --- PITCH TRAPEZOID body (near = wide/low, far = narrow/high) ---
  const near=ctx.createLinearGradient(0,horizonY,0,baseY);
  near.addColorStop(0,'#0a1d2e'); near.addColorStop(1,'#0e2b42');
  fQuad([[0,0],[FIELD.w,0],[FIELD.w,FIELD.h],[0,FIELD.h]], near);
  // vignette gradient overlay for depth (darker far)
  // mowed stripes across the DEPTH axis (bands of field-y) — perspective-correct
  const bands=14, bh=FIELD.h/bands;
  for(let i=0;i<bands;i++){
    const y0=i*bh, y1=y0+bh;
    fQuad([[0,y0],[FIELD.w,y0],[FIELD.w,y1],[0,y1]],
      i%2===0 ? 'rgba(45,230,255,0.028)' : 'rgba(45,230,255,0.058)');
  }

  ctx.lineJoin='round'; ctx.lineCap='round';
  // line width scales gently with average depth so far lines look thinner — use per-line s
  // outer boundary (touchlines + goal lines)
  ctx.strokeStyle='rgba(45,230,255,0.6)'; ctx.lineWidth=3;
  fLine(0,0, FIELD.w,0);            // far touchline
  fLine(0,FIELD.h, FIELD.w,FIELD.h);// near touchline
  fLine(0,0, 0,FIELD.h);            // left goal line
  fLine(FIELD.w,0, FIELD.w,FIELD.h);// right goal line
  // halfway line (runs across depth at x = w/2)
  ctx.strokeStyle='rgba(45,230,255,0.5)'; ctx.lineWidth=2.4;
  fLine(FIELD.w/2,0, FIELD.w/2,FIELD.h);
  // center circle + spot (radius ~80 field units)
  fArc(FIELD.w/2, FIELD.h/2, 80, 0, Math.PI*2);
  { const cp=proj(FIELD.w/2,FIELD.h/2); ctx.fillStyle='rgba(45,230,255,0.6)';
    ctx.beginPath(); ctx.arc(cp.x,cp.y,3.2*cp.s,0,Math.PI*2); ctx.fill(); }

  // penalty boxes + six-yard boxes (both ends), drawn as projected rectangles
  const boxW=110, boxH=300, boxY0=(FIELD.h-boxH)/2, boxY1=boxY0+boxH;
  const sixW=44, sixH=170, sixY0=(FIELD.h-sixH)/2, sixY1=sixY0+sixH;
  ctx.strokeStyle='rgba(45,230,255,0.5)'; ctx.lineWidth=2.2;
  function boxAt(gx, w){   // gx = goal-line x (0 or FIELD.w), w = box depth into pitch
    const inX = gx===0 ? w : FIELD.w-w;
    fLine(gx, boxY0, inX, boxY0);
    fLine(gx, boxY1, inX, boxY1);
    fLine(inX, boxY0, inX, boxY1);
  }
  boxAt(0, boxW); boxAt(FIELD.w, boxW);
  function sixAt(gx){ const w=sixW; const inX = gx===0 ? w : FIELD.w-w;
    fLine(gx, sixY0, inX, sixY0); fLine(gx, sixY1, inX, sixY1); fLine(inX, sixY0, inX, sixY1); }
  sixAt(0); sixAt(FIELD.w);
  // penalty spots + arcs (arc opens toward the pitch)
  ctx.lineWidth=2;
  const penX0=88, penX1=FIELD.w-88;
  { const p=proj(penX0,FIELD.h/2); ctx.fillStyle='rgba(45,230,255,0.55)'; ctx.beginPath(); ctx.arc(p.x,p.y,2.6*p.s,0,Math.PI*2); ctx.fill(); }
  { const p=proj(penX1,FIELD.h/2); ctx.fillStyle='rgba(45,230,255,0.55)'; ctx.beginPath(); ctx.arc(p.x,p.y,2.6*p.s,0,Math.PI*2); ctx.fill(); }
  fArc(penX0, FIELD.h/2, 74, -1.05, 1.05);              // left arc opens right
  fArc(penX1, FIELD.h/2, 74, Math.PI-1.05, Math.PI+1.05); // right arc opens left
}

// A goal is a real 3D frame: two upright posts (crossbar height GOAL_UP above the
// turf), a crossbar, and a net that recedes GOAL_DEPTH behind the goal line.
// The goal mouth spans the DEPTH axis (field-y goalTop..goalBot) so nearer post
// projects larger than the far post — reads as true perspective.
const GOAL_UP = 118;          // crossbar height above the pitch (field units, drawn UP screen)
// raise a projected field point by 'up' pitch-units (scaled by depth so posts foreshorten)
function projUp(fx, fy, up){ const p=proj(fx,fy); return { x:p.x, y:p.y - up*p.s, s:p.s }; }

function drawGoalNet(which){
  // 'far'  = the goal net mesh (behind players)   'near' = the posts/crossbar (over players)
  drawOneGoal(0,      '#2de6ff', which);   // left goal (YOU defend)
  drawOneGoal(FIELD.w,'#ff5a7a', which);   // right goal (RIVAL defend)
}
function drawOneGoal(gx, col, which){
  const outX = gx===0 ? gx-GOAL_DEPTH : gx+GOAL_DEPTH;   // back of the net (behind goal line)
  // four ground corners: front-top, front-bot, back-top, back-bot (in field-y depth)
  const fT=proj(gx, goalTop),  fB=proj(gx, goalBot);
  const bT=proj(outX, goalTop),bB=proj(outX, goalBot);
  // raised (crossbar-height) versions
  const fTu=projUp(gx, goalTop, GOAL_UP),  fBu=projUp(gx, goalBot, GOAL_UP);
  const bTu=projUp(outX, goalTop, GOAL_UP),bBu=projUp(outX, goalBot, GOAL_UP);

  if(which==='far'){
    // NET — translucent mesh on the back + side + roof panels
    ctx.save();
    ctx.fillStyle = gx===0 ? 'rgba(45,230,255,0.07)' : 'rgba(255,90,122,0.07)';
    // back panel
    ctx.beginPath(); ctx.moveTo(bT.x,bT.y); ctx.lineTo(bB.x,bB.y); ctx.lineTo(bBu.x,bBu.y); ctx.lineTo(bTu.x,bTu.y); ctx.closePath(); ctx.fill();
    // roof panel
    ctx.beginPath(); ctx.moveTo(fTu.x,fTu.y); ctx.lineTo(fBu.x,fBu.y); ctx.lineTo(bBu.x,bBu.y); ctx.lineTo(bTu.x,bTu.y); ctx.closePath(); ctx.fill();
    // net mesh lines
    ctx.strokeStyle = gx===0 ? 'rgba(45,230,255,0.22)' : 'rgba(255,90,122,0.22)'; ctx.lineWidth=1;
    const N=7;
    for(let i=1;i<N;i++){ const t=i/N;
      // vertical strands on back panel
      const a={x:bT.x+(bB.x-bT.x)*t,y:bT.y+(bB.y-bT.y)*t};
      const b={x:bTu.x+(bBu.x-bTu.x)*t,y:bTu.y+(bBu.y-bTu.y)*t};
      ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
    }
    for(let i=1;i<4;i++){ const t=i/4;
      const a={x:bT.x+(bTu.x-bT.x)*t,y:bT.y+(bTu.y-bT.y)*t};
      const b={x:bB.x+(bBu.x-bB.x)*t,y:bB.y+(bBu.y-bB.y)*t};
      ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
    }
    ctx.restore();
    return;
  }

  // which==='near' : the solid FRAME (posts + crossbar + net-depth struts), over players
  ctx.save();
  ctx.strokeStyle=col; ctx.lineWidth=Math.max(2.5, 5*fT.s); ctx.lineCap='round';
  ctx.shadowColor=col; ctx.shadowBlur=10;
  // two front posts
  ctx.beginPath(); ctx.moveTo(fT.x,fT.y); ctx.lineTo(fTu.x,fTu.y); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(fB.x,fB.y); ctx.lineTo(fBu.x,fBu.y); ctx.stroke();
  // crossbar
  ctx.beginPath(); ctx.moveTo(fTu.x,fTu.y); ctx.lineTo(fBu.x,fBu.y); ctx.stroke();
  // depth struts to the back frame (thinner)
  ctx.lineWidth=Math.max(1.5,3*fT.s); ctx.globalAlpha=0.8;
  ctx.beginPath(); ctx.moveTo(fTu.x,fTu.y); ctx.lineTo(bTu.x,bTu.y); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(fBu.x,fBu.y); ctx.lineTo(bBu.x,bBu.y); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(bTu.x,bTu.y); ctx.lineTo(bBu.x,bBu.y); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(fT.x,fT.y); ctx.lineTo(bT.x,bT.y); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(fB.x,fB.y); ctx.lineTo(bB.x,bB.y); ctx.stroke();
  ctx.restore();
}

// ---- FACELESS ARTICULATED HUMAN BODY (matches dodgeball's drawPlayer style):
//      NO face (no eyes/mouth/brows), real ELBOWS + KNEES that flex, athletic
//      proportions, team color + jersey number, ground shadow. Adapted to the
//      soccer top-down field: feet at (p.x, p.y), body drawn upright above it. ----
function drawPlayer(p){
  const isUser = (p===userControlled);
  const pf = proj(p.x, p.y);                    // projected FEET position + depth scale
  const s  = pf.s;                              // depth scale (nearer = bigger)
  const u = p.r * 0.92 * s;                     // unit size, foreshortened by depth
  const faceSign = Math.cos(p.face) >= 0 ? 1 : -1;   // face left/right
  const speed = Math.hypot(p.vx, p.vy);
  const gait = Math.min(1, speed/150);          // 0 idle -> 1 sprinting
  const dark  = tintHex(p.color, 0.55);
  const lite  = lighten(p.color);
  const surging = p.surgeT>0;

  // motion trail (projected)
  for(let i=0;i<p.trail.length;i++){
    const t=p.trail[i], tp=proj(t.x,t.y), al=i/p.trail.length*0.16;
    ctx.fillStyle=hexA(p.color,al);
    ctx.beginPath(); ctx.arc(tp.x,tp.y,p.r*tp.s*(0.35+i/p.trail.length*0.45),0,Math.PI*2); ctx.fill();
  }

  // ground shadow (feet, projected + foreshortened)
  ctx.save();
  ctx.globalAlpha=0.32; ctx.fillStyle='#000';
  ctx.beginPath(); ctx.ellipse(pf.x, pf.y, u*1.05, u*0.44, 0,0,Math.PI*2); ctx.fill();
  ctx.restore();

  // active-player ring + charge arc (at feet, projected scale)
  if(isUser){
    const pr = Math.sin(performance.now()*0.008)*0.5+0.5;
    ctx.save();
    ctx.globalAlpha=0.9; ctx.strokeStyle=p.color; ctx.lineWidth=2.5;
    ctx.shadowColor=p.color; ctx.shadowBlur=14;
    ctx.beginPath(); ctx.ellipse(pf.x, pf.y, u*1.35+pr*2, u*0.58+pr, 0,0,Math.PI*2); ctx.stroke();
    ctx.restore();
    if(charge>0){
      ctx.strokeStyle='#ffd35c'; ctx.lineWidth=3;
      ctx.beginPath(); ctx.ellipse(pf.x,pf.y,u*1.55,u*0.66,0,-Math.PI/2,-Math.PI/2+charge*Math.PI*2); ctx.stroke();
    }
  }
  // captain marker ring at feet + SURGE aura
  if(p.isCaptain && !p.gk){
    const cpp=(Math.sin(performance.now()*0.006+p.num)*0.5+0.5);
    ctx.save();
    ctx.globalAlpha=(surging?0.9:0.55)+cpp*0.3; ctx.strokeStyle=p.color; ctx.lineWidth=surging?3:2;
    ctx.shadowColor=p.color; ctx.shadowBlur=surging?20:10;
    ctx.beginPath(); ctx.ellipse(pf.x, pf.y, u*1.15+cpp*(surging?4:2), u*0.5+cpp*(surging?2:1), 0,0,Math.PI*2); ctx.stroke();
    ctx.restore();
  }
  if(surging){
    // trailing surge streaks behind the captain (projected)
    ctx.save(); ctx.globalAlpha=Math.min(1,p.surgeT/SURGE_TIME)*0.5;
    ctx.strokeStyle=lite; ctx.lineWidth=2.4; ctx.shadowColor=p.color; ctx.shadowBlur=10;
    for(let i=1;i<=3;i++){ ctx.globalAlpha=(0.4-i*0.1)*Math.min(1,p.surgeT/SURGE_TIME);
      const sp=proj(p.x - p.vx*i*0.045, p.y - p.vy*i*0.045);
      ctx.beginPath(); ctx.arc(sp.x, sp.y, u*0.5,0,Math.PI*2); ctx.stroke(); }
    ctx.restore();
  }

  // Body: translate to the PROJECTED feet. All internal offsets are in 'u' which
  // already carries the depth scale, so the whole figure foreshortens correctly.
  ctx.save();
  ctx.translate(pf.x, pf.y);

  const walk  = speed>18 ? Math.sin(p.anim*2.0) : 0;
  const walk2 = speed>18 ? Math.sin(p.anim*2.0 + Math.PI) : 0;
  const breathe = Math.sin(p.anim*1.1)*u*0.04;

  // ATHLETIC PROPORTIONS — feet at y=0, everything measured UP (negative y).
  const hipY = -u*1.55, torsoH = u*1.45;
  const shoulderY = hipY - torsoH;
  const torsoHalf = u*0.62;
  const neckY  = shoulderY - u*0.18;
  const headR  = u*0.72;                         // realistic head, NOT oversized
  const headCY = neckY - headR - u*0.06 - breathe;

  // two-segment limb bending at a joint (elbow/knee)
  function limb(rootX,rootY,endX,endY,bend,width,col){
    const dx=endX-rootX, dy=endY-rootY, len=Math.hypot(dx,dy)||1;
    const nx=-dy/len, ny=dx/len;
    const mx=(rootX+endX)/2, my=(rootY+endY)/2;
    const jx=mx+nx*bend, jy=my+ny*bend;
    ctx.strokeStyle=col; ctx.lineWidth=width; ctx.lineCap='round'; ctx.lineJoin='round';
    ctx.beginPath(); ctx.moveTo(rootX,rootY); ctx.lineTo(jx,jy); ctx.lineTo(endX,endY); ctx.stroke();
  }

  // ===== LEGS: thigh + shin bending at the KNEE =====
  const kick = p.kickAnim>0 ? (p.kickAnim/0.22) : 0;
  const legSpread=u*0.30;
  const stride=(0.28+gait*0.34)*u;
  const kneeBend=(0.18+gait*0.34)*u;
  // kick swing overrides the front leg
  const lFootX=-legSpread + walk*stride,  lFootY=-u*0.02;
  const rFootX= legSpread + walk2*stride, rFootY=-u*0.02;
  const hipLX=-legSpread*0.7, hipRX=legSpread*0.7;
  const kb = kneeBend;
  const backIsLeft = walk<0;
  const thighW=u*0.50;
  const shoeCol = p.gk ? '#ffd35c' : '#dfeefc';
  // BACK leg (behind torso)
  (function(){
    let fx2=backIsLeft?lFootX:rFootX, fy2=backIsLeft?lFootY:rFootY; const hx=backIsLeft?hipLX:hipRX;
    limb(hx,hipY, fx2,fy2, faceSign*kb, thighW, dark);
    ctx.fillStyle=shoeCol;
    ctx.beginPath(); ctx.ellipse(fx2+faceSign*u*0.10, fy2+u*0.02, u*0.26,u*0.13,0,0,Math.PI*2); ctx.fill();
  })();

  // ===== TORSO (athletic V trunk) =====
  ctx.save();
  ctx.shadowColor=p.color; ctx.shadowBlur=isUser?15:8;
  const jg=ctx.createLinearGradient(0,shoulderY,0,hipY);
  jg.addColorStop(0, lite); jg.addColorStop(1, tintHex(p.color,0.5));
  ctx.fillStyle=jg;
  const shW=torsoHalf*1.14, hpW=torsoHalf*0.86;
  function trunkPath(){
    ctx.beginPath();
    ctx.moveTo(-shW, shoulderY+u*0.05);
    ctx.quadraticCurveTo(-shW*1.02, (shoulderY+hipY)/2, -hpW, hipY);
    ctx.quadraticCurveTo(0, hipY+u*0.12, hpW, hipY);
    ctx.quadraticCurveTo(shW*1.02, (shoulderY+hipY)/2, shW, shoulderY+u*0.05);
    ctx.quadraticCurveTo(0, shoulderY-u*0.10, -shW, shoulderY+u*0.05);
    ctx.closePath();
  }
  trunkPath(); ctx.fill();
  ctx.restore();
  // jersey shade
  ctx.save(); trunkPath(); ctx.clip();
  ctx.fillStyle='rgba(0,0,0,0.24)';
  ctx.fillRect(-shW, (shoulderY+hipY)/2, shW*2, (hipY-shoulderY)/2+u);
  // subtle team accent stripe down the middle
  ctx.fillStyle=p.team==='you' ? 'rgba(255,255,255,0.20)' : 'rgba(20,10,14,0.28)';
  ctx.fillRect(-u*0.09, shoulderY, u*0.18, torsoH);
  ctx.restore();
  // jersey number
  ctx.fillStyle='#0a0a0a'; ctx.strokeStyle='rgba(255,255,255,0.9)'; ctx.lineWidth=Math.max(1,u*0.09);
  ctx.textAlign='center'; ctx.textBaseline='middle';
  ctx.font='800 '+(u*0.7).toFixed(0)+"px 'Segoe UI',sans-serif";
  const numY=(shoulderY+hipY)/2+u*0.14, numStr=String(p.num||'');
  ctx.strokeText(numStr, 0, numY); ctx.fillText(numStr, 0, numY);

  // ===== FRONT leg (over torso; swings hard on a kick) =====
  (function(){
    let fx2, fy2, hx;
    if(kick>0){
      // planted-and-swing: the front foot drives forward toward facing
      fx2 = faceSign*(u*0.35 + u*0.9*kick); fy2 = -u*0.02 - u*0.2*kick; hx = faceSign*hipRX;
    } else {
      fx2=backIsLeft?rFootX:lFootX; fy2=backIsLeft?rFootY:lFootY; hx=backIsLeft?hipRX:hipLX;
    }
    limb(hx,hipY, fx2,fy2, faceSign*(kb+kick*u*0.3), thighW, p.color);
    ctx.fillStyle= p.gk ? '#ffd35c' : '#eaf6ff';
    ctx.beginPath(); ctx.ellipse(fx2+faceSign*u*0.10, fy2+u*0.02, u*0.27,u*0.14,0,0,Math.PI*2); ctx.fill();
  })();

  // ===== ARMS: upper-arm + forearm bending at the ELBOW =====
  ctx.lineCap='round';
  const shLX=-torsoHalf*1.02, shRX=torsoHalf*1.02;
  const armW=u*0.40;
  if(kick>0){
    // kick balance: lead arm out, trailing arm back
    const t=kick;
    limb(faceSign>0?shLX:shRX, shoulderY, -faceSign*u*(0.8+0.3*t), shoulderY+u*0.4, faceSign*u*0.35, armW, dark);
    limb(faceSign>0?shRX:shLX, shoulderY,  faceSign*u*0.85, shoulderY+u*0.1, -faceSign*u*0.3, armW, p.color);
  } else if(isUser && charge>0){
    // planted, arms out for balance while charging a shot
    limb(shLX, shoulderY, -u*0.95, shoulderY+u*0.55, -u*0.3, armW, dark);
    limb(shRX, shoulderY,  u*0.95, shoulderY+u*0.55,  u*0.3, armW, p.color);
  } else {
    // run/idle: arms swing opposite to legs, elbows relaxed-bent
    const swing=(0.3+gait*0.5);
    limb(shLX,shoulderY, -torsoHalf*1.1, shoulderY+u*0.85+walk2*u*swing*0.5, -u*(0.28+gait*0.25), armW, dark);
    limb(shRX,shoulderY,  torsoHalf*1.1, shoulderY+u*0.85+walk*u*swing*0.5,   u*(0.28+gait*0.25), armW, p.color);
  }

  // ===== NECK + HEAD (clean, FACELESS — no eyes/mouth/brows) =====
  ctx.strokeStyle='#e6b58c'; ctx.lineWidth=u*0.34; ctx.lineCap='round';
  ctx.beginPath(); ctx.moveTo(0,shoulderY-u*0.02); ctx.lineTo(0,neckY); ctx.stroke();

  const hCY=headCY;
  // dark halo behind head (team glow)
  ctx.save(); ctx.shadowColor=p.color; ctx.shadowBlur=isUser?16:9;
  ctx.fillStyle='#0a0a0f';
  ctx.beginPath(); ctx.ellipse(0,hCY,headR*0.98,headR*1.06,0,0,Math.PI*2); ctx.fill();
  ctx.restore();
  // skin (soft radial shading, NO face)
  const sg=ctx.createRadialGradient(-headR*0.35, hCY-headR*0.4, headR*0.15, 0, hCY, headR);
  sg.addColorStop(0,'#ffe6cf'); sg.addColorStop(0.6,'#f0c39a'); sg.addColorStop(1,'#c98f63');
  ctx.fillStyle=sg;
  ctx.beginPath(); ctx.ellipse(0,hCY,headR*0.9,headR,0,0,Math.PI*2); ctx.fill();
  // team-color cap across the crown
  ctx.save();
  ctx.beginPath(); ctx.ellipse(0,hCY,headR*0.9,headR,0,0,Math.PI*2); ctx.clip();
  const hg=ctx.createLinearGradient(0,hCY-headR,0,hCY-headR*0.15);
  hg.addColorStop(0, lite); hg.addColorStop(1, dark); ctx.fillStyle=hg;
  ctx.beginPath();
  ctx.moveTo(-headR*0.9,hCY-headR*0.12);
  ctx.quadraticCurveTo(-headR*0.9, hCY-headR*1.02, 0, hCY-headR*1.0);
  ctx.quadraticCurveTo(headR*0.9, hCY-headR*1.02, headR*0.9, hCY-headR*0.12);
  ctx.quadraticCurveTo(headR*0.5, hCY-headR*0.32, 0, hCY-headR*0.34);
  ctx.quadraticCurveTo(-headR*0.5, hCY-headR*0.32, -headR*0.9, hCY-headR*0.12);
  ctx.closePath(); ctx.fill();
  ctx.restore();
  // crisp team-color rim around head
  ctx.lineWidth=Math.max(1.4,u*0.14); ctx.strokeStyle=p.color;
  ctx.shadowColor=p.color; ctx.shadowBlur=isUser?11:5;
  ctx.beginPath(); ctx.ellipse(0,hCY,headR*0.9,headR,0,0,Math.PI*2); ctx.stroke();
  ctx.shadowBlur=0;

  // role markers (NOT faces): GK label / captain ★ pip above the head
  if(p.gk){
    ctx.fillStyle='#ffd35c'; ctx.font='800 '+(u*0.5).toFixed(0)+"px 'Segoe UI',sans-serif";
    ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText('GK', 0, hCY-headR*1.5);
  } else if(p.isCaptain){
    ctx.fillStyle=p.color; ctx.shadowColor=p.color; ctx.shadowBlur=8;
    ctx.font='800 '+(u*0.95).toFixed(0)+"px 'Segoe UI',sans-serif";
    ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText('★', 0, hCY-headR*1.55);
    ctx.shadowBlur=0;
    // captain armband
    ctx.fillStyle=p.color;
    roundRectC(shLX-u*0.02, shoulderY+u*0.30, u*0.18, u*0.42, u*0.05); ctx.fill();
  }

  ctx.restore();

  // user chevron (screen-space, upright, above the projected head)
  if(isUser){
    ctx.save();
    ctx.fillStyle=p.color; ctx.shadowColor=p.color; ctx.shadowBlur=8;
    const ay=pf.y - u*5.6;
    const w=7*s;
    ctx.beginPath(); ctx.moveTo(pf.x,ay+8*s); ctx.lineTo(pf.x-w,ay-2*s); ctx.lineTo(pf.x+w,ay-2*s); ctx.closePath(); ctx.fill();
    ctx.restore();
  }
}
function roundRectC(x,y,w,h,r){
  ctx.beginPath();
  ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath();
}
function tintHex(hex,f){
  const c=hex.replace('#','');
  const r=parseInt(c.substring(0,2),16),g=parseInt(c.substring(2,4),16),b=parseInt(c.substring(4,6),16);
  return `rgb(${Math.round(r*f)},${Math.round(g*f)},${Math.round(b*f)})`;
}

function drawBall(){
  const bp = proj(ball.x, ball.y);
  const r = BALL_R * bp.s;
  // subtle "lift" — the faster it travels the higher it visually rides off the deck
  const spd = Math.hypot(ball.vx, ball.vy);
  const lift = Math.min(10, spd*0.012) * bp.s;
  const cxp = bp.x, cyp = bp.y - lift;
  ctx.save();
  ctx.shadowColor='rgba(255,255,255,0.6)'; ctx.shadowBlur=10;
  const g=ctx.createRadialGradient(cxp-r*0.35,cyp-r*0.35,1,cxp,cyp,r);
  g.addColorStop(0,'#ffffff'); g.addColorStop(1,'#cfe6f2');
  ctx.fillStyle=g;
  ctx.beginPath(); ctx.arc(cxp,cyp,r,0,Math.PI*2); ctx.fill();
  ctx.restore();
  ctx.fillStyle='rgba(20,30,45,0.85)';
  ctx.beginPath(); ctx.arc(cxp,cyp,r*0.35,0,Math.PI*2); ctx.fill();
}

// ------------------------------------------------------------------
// HUD
// ------------------------------------------------------------------
function drawHUD(){
  const w=cv.width, cx=w/2;
  const barW=Math.min(360*scale, w*0.7), barH=44*scale, top=14*scale;
  ctx.save();
  ctx.fillStyle='rgba(6,12,22,0.85)';
  roundRect(cx-barW/2, top, barW, barH, 10*scale); ctx.fill();
  ctx.strokeStyle='rgba(45,230,255,0.4)'; ctx.lineWidth=1.5; ctx.stroke();

  ctx.fillStyle=selectedAgent.color;
  roundRect(cx-barW/2+8*scale, top+9*scale, 10*scale, barH-18*scale, 3*scale); ctx.fill();
  ctx.fillStyle='#ff5a7a';
  roundRect(cx+barW/2-18*scale, top+9*scale, 10*scale, barH-18*scale, 3*scale); ctx.fill();

  ctx.textBaseline='middle';
  ctx.font='800 '+Math.floor(14*scale)+'px Segoe UI';
  ctx.textAlign='left'; ctx.fillStyle='#cdefff';
  ctx.fillText(selectedAgent.id, cx-barW/2+24*scale, top+barH/2);
  ctx.textAlign='right';
  ctx.fillText('RIVALS', cx+barW/2-24*scale, top+barH/2);

  ctx.textAlign='center';
  ctx.font='900 '+Math.floor(24*scale)+'px Segoe UI';
  ctx.fillStyle=selectedAgent.color;
  ctx.fillText(scoreYou, cx-30*scale, top+barH/2);
  ctx.fillStyle='#cdefff'; ctx.fillText(':', cx, top+barH/2);
  ctx.fillStyle='#ff5a7a';
  ctx.fillText(scoreOpp, cx+30*scale, top+barH/2);

  const mm=Math.floor(timeLeft/60), ss=Math.floor(timeLeft%60);
  const tstr=`${mm}:${ss<10?'0':''}${ss}`;
  ctx.font='700 '+Math.floor(13*scale)+'px Segoe UI';
  ctx.fillStyle= timeLeft<15 ? '#ff8a8a' : '#7fb8d8';
  ctx.fillText(tstr, cx, top+barH+13*scale);

  // ACTIVE CAMERA VIEW label (top-right pill) — pulses briefly after pressing V
  const vLabel = `◉ ${VIEW_NAMES[cameraView]}`;
  const vFont = Math.floor((viewFlash>0?13:11)*scale);
  ctx.font='800 '+vFont+'px Segoe UI';
  const vw = ctx.measureText(vLabel).width + 22*scale;
  const vx = cv.width - vw - 12*scale, vy = 14*scale, vh = 26*scale;
  ctx.fillStyle= viewFlash>0 ? 'rgba(45,230,255,0.22)' : 'rgba(6,12,22,0.8)';
  roundRect(vx, vy, vw, vh, 8*scale); ctx.fill();
  ctx.strokeStyle= viewFlash>0 ? '#2de6ff' : 'rgba(45,230,255,0.4)';
  ctx.lineWidth=1.5; ctx.stroke();
  ctx.textAlign='center'; ctx.textBaseline='middle';
  ctx.fillStyle= viewFlash>0 ? '#cdefff' : '#7fb8d8';
  ctx.fillText(vLabel, vx+vw/2, vy+vh/2 + 1*scale);
  if(viewFlash<=0){
    ctx.font='600 '+Math.floor(8.5*scale)+'px Segoe UI';
    ctx.fillStyle='rgba(127,184,216,0.7)';
    ctx.fillText('[V] VIEW', vx+vw/2, vy+vh+7*scale);
  }

  // stamina bar (bottom-left) — hidden in WATCH mode (no human player)
  if(!watchOn){
  const stX=16*scale, stY=cv.height-30*scale, stW=170*scale, stH=12*scale;
  ctx.fillStyle='rgba(6,12,22,0.8)';
  roundRect(stX-4*scale, stY-16*scale, stW+8*scale, stH+22*scale, 6*scale); ctx.fill();
  ctx.fillStyle='#4a7590'; ctx.textAlign='left'; ctx.font='700 '+Math.floor(10*scale)+'px Segoe UI';
  ctx.fillText('STAMINA', stX, stY-9*scale);
  ctx.fillStyle='rgba(255,255,255,0.1)';
  roundRect(stX,stY,stW,stH,4*scale); ctx.fill();
  ctx.fillStyle = stamina>0.3 ? '#38ffb0' : '#ff8a8a';
  roundRect(stX,stY,stW*stamina,stH,4*scale); ctx.fill();
  }

  // ── CAPTAIN SURGE indicator (bottom-center) — mirrors dodgeball OVERDRIVE HUD ──
  if(!watchOn){
    const cap = findTeamCaptain('you');
    if(cap){
      const ready = cap.capCd<=0 && cap.surgeT<=0;
      const active = cap.surgeT>0;
      const sw=150*scale, sh=30*scale, sx0=cv.width/2-sw/2, sy0=cv.height-40*scale;
      ctx.fillStyle='rgba(6,12,22,0.82)';
      roundRect(sx0, sy0, sw, sh, 8*scale); ctx.fill();
      const col = active ? '#ffd35c' : (ready ? selectedAgent.color : '#4a7590');
      ctx.strokeStyle=col; ctx.lineWidth=1.5;
      roundRect(sx0, sy0, sw, sh, 8*scale); ctx.stroke();
      // cooldown fill
      if(!ready && !active){
        const frac=1-Math.max(0,cap.capCd)/SURGE_COOLDOWN;
        ctx.fillStyle='rgba(45,230,255,0.16)';
        roundRect(sx0, sy0, sw*frac, sh, 8*scale); ctx.fill();
      } else if(active){
        const frac=Math.max(0,cap.surgeT)/SURGE_TIME;
        ctx.fillStyle='rgba(255,211,92,0.25)';
        roundRect(sx0, sy0, sw*frac, sh, 8*scale); ctx.fill();
      }
      ctx.textAlign='center'; ctx.textBaseline='middle';
      ctx.font='800 '+Math.floor(12*scale)+'px Segoe UI';
      ctx.fillStyle=col;
      const label = active ? '⚡ SURGE!' : (ready ? '[Q] SURGE ★' : 'SURGE …');
      ctx.fillText(label, cv.width/2, sy0+sh/2);
    }
  }

  // charge indicator bottom-right
  if(charge>0 && !watchOn){
    const chX=cv.width-186*scale, chY=cv.height-30*scale, chW=170*scale, chH=12*scale;
    ctx.fillStyle='rgba(6,12,22,0.8)';
    roundRect(chX-4*scale, chY-16*scale, chW+8*scale, chH+22*scale, 6*scale); ctx.fill();
    ctx.fillStyle='#4a7590'; ctx.textAlign='left'; ctx.font='700 '+Math.floor(10*scale)+'px Segoe UI';
    ctx.fillText('POWER', chX, chY-9*scale);
    ctx.fillStyle='rgba(255,255,255,0.1)'; roundRect(chX,chY,chW,chH,4*scale); ctx.fill();
    ctx.fillStyle='#ffd35c'; roundRect(chX,chY,chW*charge,chH,4*scale); ctx.fill();
  }
  ctx.restore();
}

// ------------------------------------------------------------------
// HELPERS
// ------------------------------------------------------------------
function roundRect(x,y,w,h,r){
  ctx.beginPath();
  ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath();
}
function hexA(hex,a){
  const c=hex.replace('#','');
  const r=parseInt(c.substring(0,2),16),g=parseInt(c.substring(2,4),16),b=parseInt(c.substring(4,6),16);
  return `rgba(${r},${g},${b},${a})`;
}
function lighten(hex){
  const c=hex.replace('#','');
  let r=parseInt(c.substring(0,2),16),g=parseInt(c.substring(2,4),16),b=parseInt(c.substring(4,6),16);
  r=Math.min(255,r+60);g=Math.min(255,g+60);b=Math.min(255,b+60);
  return `rgb(${r},${g},${b})`;
}

