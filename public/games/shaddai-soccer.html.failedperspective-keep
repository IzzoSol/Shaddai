<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>SHADDAI SOCCER</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; -webkit-user-select:none; user-select:none; }
  html,body { width:100vw; height:100vh; overflow:hidden; background:#05070d; font-family:'Segoe UI',system-ui,sans-serif; color:#e8f6ff; }
  #wrap { position:fixed; inset:0; display:flex; align-items:center; justify-content:center; }
  canvas { display:block; background:#0a1420; touch-action:none; image-rendering:auto; max-width:100vw; max-height:100vh; }

  /* ONE clean top strip: title + single BACK button */
  #topStrip {
    position:fixed; top:0; left:0; right:0; z-index:50;
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    padding:10px clamp(12px,3vw,22px);
    background:linear-gradient(180deg,rgba(4,7,13,.82),rgba(4,7,13,0));
    pointer-events:none;
  }
  body.playing #topStrip { background:none; }
  #topStrip .brand {
    font-weight:900; letter-spacing:2px; font-size:clamp(13px,2.4vw,17px);
    background:linear-gradient(90deg,#2de6ff,#ffd35c); -webkit-background-clip:text;
    background-clip:text; color:transparent; white-space:nowrap;
  }
  .navbtns{display:flex;gap:8px;align-items:center;pointer-events:none;}
  #backBtn,#codexBtn {
    pointer-events:auto;
    background:rgba(8,14,24,.8); border:1px solid #2de6ff; color:#2de6ff;
    padding:8px 16px; border-radius:9px; font-weight:800; font-size:13px; cursor:pointer;
    letter-spacing:1px; backdrop-filter:blur(6px); transition:.15s; white-space:nowrap;
  }
  #backBtn:hover { background:#2de6ff; color:#05070d; box-shadow:0 0 18px rgba(45,230,255,.6); }
  #codexBtn { border-color:#ffd35c; color:#ffd35c; }
  #codexBtn:hover { background:#ffd35c; color:#05070d; box-shadow:0 0 18px rgba(255,211,92,.6); }

  /* Overlay screens — cinematic HF background behind a readable scrim */
  .screen {
    position:fixed; inset:0; z-index:30; display:flex; flex-direction:column;
    align-items:center; justify-content:flex-start; text-align:center;
    padding:clamp(58px,9vh,80px) clamp(16px,4vw,32px) clamp(24px,5vh,40px);
    overflow-y:auto; overflow-x:hidden;
    background:
      linear-gradient(180deg, rgba(3,5,10,.82), rgba(3,5,10,.9) 55%, rgba(3,5,10,.97)),
      url('/assets/games/soccer/bg.png') center/cover no-repeat,
      radial-gradient(ellipse at 50% 30%, #0c1828, #03050a);
  }
  .screen > * { position:relative; z-index:1; width:100%; max-width:820px; }
  .hidden { display:none !important; }
  .title {
    font-size:clamp(34px,7vw,68px); font-weight:900; letter-spacing:4px;
    background:linear-gradient(90deg,#2de6ff,#ffd35c,#2de6ff);
    -webkit-background-clip:text; background-clip:text; color:transparent;
    text-shadow:0 0 40px rgba(45,230,255,.25); margin-bottom:4px;
  }
  .sub { color:#7fb8d8; font-size:14px; letter-spacing:6px; margin-bottom:22px; text-transform:uppercase; }
  .label { color:#ffd35c; font-size:13px; letter-spacing:3px; text-transform:uppercase; margin:18px 0 10px; }

  .agents { display:flex; flex-wrap:wrap; gap:14px; justify-content:center; max-width:900px; margin:0 auto; }
  /* Polished VERTICAL character card: portrait on top, name + role, stats below */
  .agent {
    width:150px; border-radius:16px; cursor:pointer; overflow:hidden;
    background:linear-gradient(180deg,rgba(14,26,42,.85),rgba(8,16,28,.92));
    border:2px solid rgba(45,230,255,.15);
    transition:transform .15s, border-color .15s, box-shadow .15s; position:relative;
    display:flex; flex-direction:column;
  }
  .agent:hover { transform:translateY(-4px); border-color:rgba(45,230,255,.55); }
  .agent.sel { border-color:var(--ac); box-shadow:0 0 26px -4px var(--ac); }
  .agent.sel::after {
    content:'✓ CAPTAIN'; position:absolute; top:8px; right:8px; z-index:3;
    background:var(--ac); color:#05070d; font-size:9px; font-weight:900; letter-spacing:1px;
    padding:2px 7px; border-radius:6px; box-shadow:0 0 12px -2px var(--ac);
  }
  /* Portrait region — vertical, holds the FLUX kit art with a neon color wash */
  .agent .port {
    position:relative; width:100%; aspect-ratio:3/4; overflow:hidden;
    background:
      linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(6,12,22,.9)),
      radial-gradient(ellipse at 50% 25%, color-mix(in srgb, var(--ac) 32%, #0a1420), #070d16);
  }
  .agent .port img {
    position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:top center;
    display:block; transition:transform .2s;
  }
  .agent:hover .port img { transform:scale(1.05); }
  .agent .port .glow { position:absolute; inset:0; box-shadow:inset 0 0 40px -10px var(--ac); pointer-events:none; }
  /* Fallback initial badge shown when no portrait image */
  .agent .badge {
    position:absolute; inset:0; margin:auto; width:64px; height:64px; border-radius:50%;
    display:flex; align-items:center; justify-content:center; font-weight:900; font-size:26px;
    color:#05070d; box-shadow:0 0 22px -4px var(--ac); background:var(--ac);
  }
  .agent .info { padding:8px 10px 4px; }
  .agent .nm { font-weight:900; letter-spacing:1px; font-size:15px; color:#e8f6ff; }
  .agent .rl { font-size:9px; color:var(--ac); letter-spacing:1.5px; margin:1px 0 8px; text-transform:uppercase; opacity:.9; }
  .agent .stats-wrap { padding:0 10px 12px; }
  .stat { display:flex; align-items:center; gap:6px; font-size:10px; margin:3px 0; color:#9fd0e8; }
  .stat .bar { flex:1; height:5px; background:rgba(255,255,255,.08); border-radius:3px; overflow:hidden; }
  .stat .bar i { display:block; height:100%; background:var(--ac); border-radius:3px; }
  .stat .k { width:44px; text-align:left; text-transform:uppercase; letter-spacing:.5px; color:#6fa8c8; }

  /* Skill loadout cards (SKILLPLAY) */
  .skillcard {
    width:200px; min-height:96px; border-radius:14px; cursor:pointer; position:relative;
    padding:12px 14px; text-align:left; display:flex; flex-direction:column; gap:4px;
    background:linear-gradient(180deg,rgba(14,26,42,.85),rgba(8,16,28,.92));
    border:2px solid rgba(45,230,255,.22); transition:transform .15s, border-color .15s, box-shadow .15s;
  }
  .skillcard:hover { transform:translateY(-3px); border-color:rgba(45,230,255,.55); }
  .skillcard.sel { border-color:#2de6ff; box-shadow:0 0 22px -4px #2de6ff; background:rgba(45,230,255,.12); }
  .skillcard.matched { border-color:rgba(255,211,92,.55); }
  .skillcard.matched.sel { border-color:#2de6ff; }
  .skillcard .snm { font-weight:900; letter-spacing:.5px; font-size:14px; color:#e8f6ff; display:flex; align-items:center; gap:7px; }
  .skillcard .sdesc { font-size:11px; color:#9fd0e8; line-height:1.35; }
  .skillcard .sbadge { position:absolute; top:8px; right:10px; font-size:12px; font-weight:900; color:#ffd35c; text-shadow:0 0 8px rgba(255,211,92,.6); }
  .skillcard.sel .sbadge { color:#2de6ff; text-shadow:0 0 8px rgba(45,230,255,.7); }
  .skillcard .sicon { font-size:18px; }

  /* MODE SELECT cards (PLAY / WATCH / SKILL PLAY) */
  .modes { display:flex; flex-wrap:wrap; gap:18px; justify-content:center; margin:14px auto 0; max-width:820px; }
  .mode {
    width:230px; min-height:250px; border-radius:18px; cursor:pointer; position:relative;
    padding:24px 18px 20px; text-align:center; display:flex; flex-direction:column; align-items:center; gap:8px;
    background:linear-gradient(180deg,rgba(14,26,42,.85),rgba(6,12,22,.94));
    border:2px solid rgba(45,230,255,.22); transition:transform .16s, border-color .16s, box-shadow .16s;
  }
  .mode:hover { transform:translateY(-5px); border-color:var(--mc); box-shadow:0 0 30px -6px var(--mc); }
  .mode.sel { border-color:var(--mc); box-shadow:0 0 34px -6px var(--mc); background:linear-gradient(180deg,color-mix(in srgb,var(--mc) 16%,rgba(14,26,42,.85)),rgba(6,12,22,.94)); }
  .mode .micon { font-size:52px; line-height:1; color:var(--mc); text-shadow:0 0 22px var(--mc); }
  .mode .mtitle { font-weight:900; letter-spacing:2px; font-size:22px; color:#e8f6ff; }
  .mode .msub { font-size:11px; letter-spacing:2px; text-transform:uppercase; color:var(--mc); font-weight:800; }
  .mode .mdesc { font-size:12px; color:#9fd0e8; line-height:1.45; margin-top:4px; }
  .mode .mgo { margin-top:auto; font-weight:900; letter-spacing:1.5px; font-size:12px; color:var(--mc);
    opacity:0; transition:opacity .16s; }
  .mode:hover .mgo, .mode.sel .mgo { opacity:1; }

  /* WATCH-mode spectate banner during a match */
  #spectateBanner {
    position:fixed; top:64px; left:50%; transform:translateX(-50%); z-index:22;
    display:none; align-items:center; gap:10px; padding:8px 20px; border-radius:12px;
    background:rgba(6,12,22,.82); border:1px solid #2de6ff; color:#2de6ff;
    font-weight:900; letter-spacing:3px; font-size:13px; backdrop-filter:blur(6px);
    box-shadow:0 0 24px -6px rgba(45,230,255,.6); pointer-events:none; white-space:nowrap;
  }
  #spectateBanner .dot { width:9px; height:9px; border-radius:50%; background:#ff5a7a; box-shadow:0 0 10px #ff5a7a; animation:specPulse 1.1s infinite; }
  @keyframes specPulse { 0%,100%{opacity:1;} 50%{opacity:.25;} }
  body.watching #spectateBanner { display:flex; }

  .durs { display:flex; gap:12px; justify-content:center; }
  .dur {
    padding:10px 22px; border-radius:10px; cursor:pointer; font-weight:800; letter-spacing:1px;
    background:rgba(10,20,34,.7); border:2px solid rgba(255,211,92,.2); color:#ffd35c; transition:.15s;
  }
  .dur:hover { border-color:rgba(255,211,92,.6); }
  .dur.sel { background:#ffd35c; color:#05070d; box-shadow:0 0 20px -4px #ffd35c; }

  .btn {
    margin-top:26px; padding:15px 52px; border-radius:12px; cursor:pointer;
    font-weight:900; font-size:18px; letter-spacing:3px; border:none;
    background:linear-gradient(90deg,#2de6ff,#38ffb0); color:#05070d;
    box-shadow:0 0 30px -6px #2de6ff; transition:.15s;
  }
  .btn:hover { transform:scale(1.04); box-shadow:0 0 40px -4px #2de6ff; }
  .btn.gold { background:linear-gradient(90deg,#ffd35c,#ff9f45); box-shadow:0 0 30px -6px #ffd35c; }

  .controls-legend {
    margin:24px auto 0; font-size:13px; color:#9fcbe4; line-height:1.6;
    max-width:600px; padding:16px 20px; border-radius:14px;
    background:rgba(6,12,22,.66); border:1px solid rgba(45,230,255,.18);
    display:flex; flex-wrap:wrap; gap:8px 14px; justify-content:center; align-items:center;
    word-wrap:break-word;
  }
  .controls-legend .row { display:flex; flex-wrap:wrap; gap:6px 14px; justify-content:center; align-items:center; width:100%; }
  .controls-legend .item { display:inline-flex; align-items:center; gap:6px; white-space:nowrap; }
  .controls-legend .note { width:100%; color:#7fb8d8; font-size:12px; margin-top:4px; line-height:1.5; }
  .controls-legend b { color:#2de6ff; }
  .key { display:inline-block; background:rgba(45,230,255,.12); border:1px solid rgba(45,230,255,.35);
    border-radius:6px; padding:2px 8px; font-weight:700; color:#cdefff; font-size:11px; letter-spacing:.5px; }

  #resultTitle { font-size:clamp(40px,9vw,90px); font-weight:900; letter-spacing:5px; }
  #resultScore { font-size:clamp(28px,6vw,52px); font-weight:800; margin:6px 0 4px; color:#cdefff; }
  #resultSub { color:#c7e2f2; letter-spacing:2px; margin-bottom:8px; }

  #pauseHint { position:fixed; bottom:12px; left:50%; transform:translateX(-50%); z-index:20;
    color:#7fb8d8; font-size:11px; letter-spacing:2px; background:rgba(4,7,13,.6);
    padding:5px 12px; border-radius:8px; pointer-events:none; }
</style>
</head>
<body>
<div id="wrap"><canvas id="cv"></canvas></div>

<!-- ONE clean top strip -->
<div id="topStrip">
  <button id="backBtn">◀ ARCADE MENU</button>
  <div class="navbtns">
    <button id="codexBtn" title="Back to Codex">⌂ CODEX</button>
    <div class="brand">SHADDAI SOCCER</div>
  </div>
</div>

<div id="pauseHint" class="hidden">P / ESC — PAUSE</div>
<div id="spectateBanner"><span class="dot"></span> SPECTATING · AI vs AI · [P] MENU</div>

<!-- SELECT SCREEN -->
<div id="selectScreen" class="screen">
  <div class="title">SHADDAI SOCCER</div>
  <div class="sub">Neon Pitch · Council Cup</div>

  <div class="label">Choose Your Captain</div>
  <div class="agents" id="agentList"></div>

  <div class="label">Team Size</div>
  <div class="durs" id="sizeList">
    <div class="dur" data-size="5">5 v 5</div>
    <div class="dur sel" data-size="6">6 v 6</div>
  </div>

  <div class="label">Match Length</div>
  <div class="durs" id="durList">
    <div class="dur" data-min="1">1 MIN</div>
    <div class="dur sel" data-min="2">2 MIN</div>
    <div class="dur" data-min="3">3 MIN</div>
  </div>

  <button class="btn" id="startBtn">KICK OFF ▸</button>

  <div class="controls-legend">
    <div class="row">
      <span class="item"><span class="key">WASD</span><span class="key">Arrows</span> Move</span>
      <span class="item"><span class="key">Space</span><span class="key">J</span> Kick / Pass (hold to charge)</span>
      <span class="item"><span class="key">Shift</span> Sprint</span>
      <span class="item"><span class="key">Q</span> Captain SURGE ★</span>
      <span class="item"><span class="key">Tab</span><span class="key">K</span> Switch player</span>
      <span class="item"><span class="key">V</span> Camera view</span>
      <span class="item"><span class="key">P</span><span class="key">Esc</span> Pause</span>
    </div>
    <div class="note"><b>Keyboard only.</b> Nearest player to the ball is auto-selected. Next you'll pick a mode: <b>PLAY</b> · <b>WATCH</b> (AI vs AI) · <b>SKILL PLAY</b>. Score more than your rival before full time.</div>
  </div>
</div>

<!-- MODE SELECT SCREEN -->
<div id="modeScreen" class="screen hidden">
  <div class="title" style="font-size:clamp(30px,6vw,58px)">SELECT MODE</div>
  <div class="sub" id="modeSub">Choose how you play</div>
  <div class="modes" id="modeList"></div>
  <button class="btn" id="modeBackBtn" style="margin-top:22px;background:rgba(45,230,255,.15);color:#2de6ff;box-shadow:none;border:1px solid #2de6ff;">◀ BACK</button>
</div>

<!-- SKILL SELECT SCREEN (SKILLPLAY) -->
<div id="skillScreen" class="screen hidden">
  <div class="title" style="font-size:clamp(28px,6vw,56px)">ACTIVATE SKILLS</div>
  <div class="sub" id="skillSub">Ability Loadout</div>
  <div class="label" id="skillHint">Pick up to 3 — ★ = auto-matched to your captain</div>
  <div class="agents" id="skillList" style="max-width:760px"></div>
  <button class="btn gold" id="skillStartBtn" style="margin-top:22px">START WITH SKILLS ▸</button>
  <button class="btn" id="skillBackBtn" style="margin-top:12px;background:rgba(45,230,255,.15);color:#2de6ff;box-shadow:none;border:1px solid #2de6ff;">◀ BACK</button>
</div>

<!-- RESULT SCREEN -->
<div id="resultScreen" class="screen hidden">
  <div id="resultTitle" class="title">FULL TIME</div>
  <div id="resultScore">0 — 0</div>
  <div id="resultSub">GOOD MATCH</div>
  <button class="btn gold" id="restartBtn">PLAY AGAIN ▸</button>
  <button class="btn" id="menuBtn" style="margin-top:14px;background:rgba(45,230,255,.15);color:#2de6ff;box-shadow:none;border:1px solid #2de6ff;">MAIN MENU</button>
</div>

<!-- PAUSE SCREEN -->
<div id="pauseScreen" class="screen hidden">
  <div class="title" style="font-size:clamp(30px,6vw,56px)">PAUSED</div>
  <div class="sub">Take a breath</div>
  <button class="btn" id="resumeBtn">RESUME ▸</button>
  <button class="btn" id="quitBtn" style="margin-top:14px;background:rgba(255,90,90,.15);color:#ff8a8a;box-shadow:none;border:1px solid #ff5a5a;">QUIT MATCH</button>
</div>

<script>
"use strict";
(function(){
// ------------------------------------------------------------------
// AGENT ROSTER
// ------------------------------------------------------------------
const AGENTS = [
  { id:'SHADDAI', role:'Orchestrator', color:'#ffd35c', speed:0.85, power:0.9,  control:0.85 },
  { id:'NEXUS',   role:'Architect',    color:'#2de6ff', speed:0.8,  power:0.85, control:0.9  },
  { id:'ZEROX',   role:'Revenue',      color:'#38ffb0', speed:0.95, power:0.75, control:0.8  },
  { id:'ORACLE',  role:'Research',     color:'#b98cff', speed:0.8,  power:0.8,  control:0.95 },
  { id:'TURTLE',  role:'Creative',     color:'#5cff7a', speed:0.7,  power:0.95, control:0.9  },
  { id:'QUILL',   role:'Comms',        color:'#ff9f45', speed:0.9,  power:0.8,  control:0.85 },
  { id:'PIKADON', role:'Security',     color:'#ff5a7a', speed:0.85, power:1.0,  control:0.7  },
];
// Themed soccer-kit portraits (uppercase filenames). Fallback to any legacy select art, then initial badge.
const CHAR_ART = id => `/assets/games/soccer/chars/${id}.png`;
const FALLBACK_ART = id => `/assets/games/soccer/${id.toLowerCase()}.png`;

let selectedAgent = AGENTS[0];
let matchMinutes = 2;

// GAME MODE: 'play' (human + AI teammates vs AI), 'watch' (full AI vs AI spectate), 'skill' (skill loadout → play)
let gameMode = 'play';
let watchOn = false;   // true = WATCH mode: block human input, AI drives the YOU team too

// ------------------------------------------------------------------
// SKILLPLAY — ability catalog (ids match backend soccer catalog:
// backend/platform/skillplay.js). Boosts map to gameplay stats.
// ------------------------------------------------------------------
const ALL_SKILL_DEFS = [
  { id:'finisher',     icon:'🎯', label:'Finisher',     desc:'Clinical in the box — buries the chance.',   boost:{power:0.18} },
  { id:'playmaker',    icon:'🧠', label:'Playmaker',    desc:'Threads killer passes, unlocks defenses.',   boost:{control:0.18} },
  { id:'speedster',    icon:'⚡', label:'Speedster',    desc:'Burns past defenders on the flank.',         boost:{speed:0.20} },
  { id:'wall',         icon:'🛡', label:'Back Wall',    desc:'Immovable in defense, wins every duel.',     boost:{defense:0.22} },
  { id:'free_kick_ace',icon:'🎪', label:'Set-Piece Ace',desc:'Bends set-pieces into the top corner.',      boost:{power:0.12, control:0.10} },
  { id:'engine',       icon:'🔋', label:'Engine',       desc:'Box-to-box stamina, presses all match.',     boost:{stamina:0.35} },
  { id:'interceptor',  icon:'🪤', label:'Interceptor',  desc:'Reads the pass and steps in to win it.',     boost:{defense:0.16, control:0.08} },
  { id:'dribble_king', icon:'🕺', label:'Dribble King', desc:'Close control glides through traffic.',       boost:{control:0.16, speed:0.08} },
];
// Council-agent natural abilities (auto-matched + ★ badged). Forged agents fall through.
const AGENT_ABILITIES = {
  SHADDAI: ['playmaker','finisher','free_kick_ace'],
  NEXUS:   ['playmaker','interceptor','wall'],
  ZEROX:   ['speedster','dribble_king','finisher'],
  ORACLE:  ['playmaker','interceptor','dribble_king'],
  TURTLE:  ['dribble_king','finisher','free_kick_ace'],
  QUILL:   ['playmaker','speedster','engine'],
  PIKADON: ['wall','interceptor','finisher'],
};
const skillPickMax = 3;
let skillPicked = [];          // array of ALL_SKILL_DEFS indices
let agentMatchedIds = [];      // auto-matched ability ids for chosen captain
// Boosts summed from picked skills — applied to YOU team only.
let skillBoosts = { power:0, control:0, speed:0, stamina:0, defense:0 };

function computeAgentMatchedLocal(){
  const a = (selectedAgent && AGENT_ABILITIES[selectedAgent.id]) ? AGENT_ABILITIES[selectedAgent.id].slice() : [];
  return a.length ? a : ['playmaker','finisher','speedster'];
}
// Scalable path: ask backend to auto-match this captain's REAL skills → abilities.
function refreshAgentMatchedFromBackend(){
  const id = selectedAgent && selectedAgent.id; if(!id) return;
  try{
    fetch('/api/skillplay/soccer/kit/'+encodeURIComponent(id)+'?n=3')
      .then(r=>r.json())
      .then(j=>{
        if(j && j.ok && j.abilities && j.abilities.length){
          agentMatchedIds = j.abilities.map(x=>x.id);
          renderSkillCards(); // re-badge if user still on the screen
        }
      }).catch(()=>{});
  }catch(e){}
}
function applySkillBoosts(){
  skillBoosts = { power:0, control:0, speed:0, stamina:0, defense:0 };
  for(const idx of skillPicked){
    const sk = ALL_SKILL_DEFS[idx]; if(!sk) continue;
    for(const k in sk.boost){ if(sk.boost.hasOwnProperty(k)) skillBoosts[k] = (skillBoosts[k]||0) + sk.boost[k]; }
  }
}
// Effective stat helper — adds the named skill boost to a base value for the YOU team only
// (mirrors football getEffectiveRating). key ∈ {power,control,speed,stamina,defense}.
function getEffectiveStat(base, team, key){
  if(team!=='you') return base;
  const add = (key && skillBoosts[key]) ? skillBoosts[key] : 0;
  return base + add;
}

// ------------------------------------------------------------------
// SELECT SCREEN UI
// ------------------------------------------------------------------
const agentList = document.getElementById('agentList');
AGENTS.forEach((a,i)=>{
  const el = document.createElement('div');
  el.className = 'agent' + (i===0?' sel':'');
  el.style.setProperty('--ac', a.color);
  el.innerHTML =
    `<div class="port">
       <div class="badge" style="background:${a.color}">${a.id[0]}</div>
       <img alt="${a.id}" src="${CHAR_ART(a.id)}"
            onload="this.previousElementSibling.style.display='none'"
            onerror="if(!this.dataset.fb){this.dataset.fb=1;this.src='${FALLBACK_ART(a.id)}';}else{this.remove();}">
       <div class="glow"></div>
