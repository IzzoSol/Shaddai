// read-only debug snapshot (used by headless QA; harmless in production)
window.__soccerDebug = function(){
  return {
    state, scoreYou, scoreOpp,
    ball: ball ? {x:ball.x,y:ball.y,vx:ball.vx,vy:ball.vy,spin:ball.spin} : null,
    owner: ballOwner ? (ballOwner.team+':'+ballOwner.num) : null,
    watchOn
  };
};
function loop(t){
  requestAnimationFrame(loop);
  let dt=(t-lastTime)/1000; lastTime=t;
  if(dt>0.05) dt=0.05; // clamp
  if(state==='play' || state==='celebrate'){ update(dt); }
  if(state!=='menu' && ball){ draw(); }
}
requestAnimationFrame(loop);

// ------------------------------------------------------------------
// FLOW / BUTTONS
// ------------------------------------------------------------------
function startGame(){
  document.getElementById('selectScreen').classList.add('hidden');
  document.getElementById('modeScreen').classList.add('hidden');
  document.getElementById('resultScreen').classList.add('hidden');
  document.getElementById('pauseScreen').classList.add('hidden');
  document.getElementById('pauseHint').classList.toggle('hidden', watchOn);
  document.body.classList.add('playing');
  document.body.classList.toggle('watching', watchOn);
  initMatch();
  state='play';
}
function togglePause(){
  if(state==='play'){ state='pause'; document.getElementById('pauseScreen').classList.remove('hidden'); }
  else if(state==='pause'){ state='play'; document.getElementById('pauseScreen').classList.add('hidden'); }
}

// KICK OFF now routes: SELECT → MODE SELECT → (SKILL SELECT) → MATCH
document.getElementById('startBtn').addEventListener('click', gotoModeSelect);
document.getElementById('modeBackBtn').addEventListener('click', ()=>{
  document.getElementById('modeScreen').classList.add('hidden');
  document.getElementById('selectScreen').classList.remove('hidden');
  state='menu';
});
document.getElementById('skillStartBtn').addEventListener('click', confirmSkillPlay);
document.getElementById('skillBackBtn').addEventListener('click', ()=>{
  document.getElementById('skillScreen').classList.add('hidden');
  gotoModeSelect();  // SKILL PLAY was reached from MODE select → go back there
});
// PLAY AGAIN / restart replays with the same captain + skills already chosen
document.getElementById('restartBtn').addEventListener('click', startGame);
document.getElementById('menuBtn').addEventListener('click', ()=>{
  document.getElementById('resultScreen').classList.add('hidden');
  document.getElementById('skillScreen').classList.add('hidden');
  document.getElementById('modeScreen').classList.add('hidden');
  document.getElementById('selectScreen').classList.remove('hidden');
  document.getElementById('pauseHint').classList.add('hidden');
  document.body.classList.remove('playing','watching');
  state='menu';
});
document.getElementById('resumeBtn').addEventListener('click', ()=>{
  document.getElementById('pauseScreen').classList.add('hidden'); state='play';
});
document.getElementById('quitBtn').addEventListener('click', ()=>{
  document.getElementById('pauseScreen').classList.add('hidden');
  document.getElementById('skillScreen').classList.add('hidden');
  document.getElementById('modeScreen').classList.add('hidden');
  document.getElementById('selectScreen').classList.remove('hidden');
  document.getElementById('pauseHint').classList.add('hidden');
  document.body.classList.remove('playing','watching');
  state='menu';
});

// BACK button — returns to the arcade (same exit logic as before)
document.getElementById('backBtn').addEventListener('click', ()=>{
  try{ window.parent.postMessage({type:'exitGame'}, '*'); }catch(e){}
  try{ window.parent.postMessage({type:'shaddai-close-panel'}, '*'); }catch(e){}
  try{ if(window.parent && window.parent.closeGame){ window.parent.closeGame(); } }catch(e){}
  try{ if(window.parent===window && window.history.length>1){ window.history.back(); } }catch(e){}
});
document.getElementById('codexBtn').addEventListener('click', ()=>{
  try{ (window.top||window).location.href='/codex.html'; }catch(e){ location.href='/codex.html'; }
});

})();
