# AURA Environment Variables — copy this to .env and fill in your keys

# ── Server ────────────────────────────────────────────────────────────────────
AURA_HOST=0.0.0.0
AURA_PORT=8010
DEBUG=False

# ── Ollama (local, free) ──────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
# Other free options: mistral, phi3, gemma2:2b, qwen2:1.5b

# ── LM Studio (local, free — download models at lmstudio.ai) ─────────────────
LMSTUDIO_URL=http://localhost:1234
LMSTUDIO_MODEL=local-model
LMSTUDIO_ENABLED=false

# ── Jan.ai (local, free — download at jan.ai) ─────────────────────────────────
JANAI_URL=http://localhost:1337
JANAI_MODEL=mistral-7b-instruct
JANAI_ENABLED=false

# ── OpenRouter (free tier — get key at openrouter.ai) ────────────────────────
OPENROUTER_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
OPENROUTER_ENABLED=false

# ── AceDataCloud ──────────────────────────────────────────────────────────────
ACEDATACLOUD_KEY=

# ── Groq (very fast, generous free tier) ─────────────────────────────────────
GROQ_KEY=

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_KEY=

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_KEY=

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_KEY=

# ── DeepSeek ─────────────────────────────────────────────────────────────────
DEEPSEEK_KEY=

# ── xAI (Grok) ───────────────────────────────────────────────────────────────
XAI_KEY=

# ── SHADDAI Backend (your local agents) ──────────────────────────────────────
SHADDAI_BACKEND=http://localhost:3000

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_DB_PATH=aura_cache.db
CACHE_TTL_AGENT=3600
CACHE_TTL_MARKET=300
CACHE_TTL_SEARCH=900
AGENT_TIMEOUT=30
