  const roster = (matchConfig && Array.isArray(matchConfig.activeRoster)) ? matchConfig.activeRoster : null;
  // YOU team (attacks to the right, defends left goal)
  form.forEach((f,i)=>{
    const home = { x: f.x*FIELD.w, y: f.y*FIELD.h, gk:f.gk };
    const p = makePlayer('you', home, i===capIdx, roster ? roster[i] : null); // captain = most-central outfield
    p.num = f.gk ? 1 : (i===capIdx ? 10 : (i+2));   // #1 keeper, #10 captain
    players.push(p);
  });
  // OPP team (mirrored, attacks left)
  form.forEach((f,i)=>{
    const home = { x: (1-f.x)*FIELD.w, y: f.y*FIELD.h, gk:f.gk };
    const p = makePlayer('opp', home, false);
    p.num = f.gk ? 1 : (i+2);
    players.push(p);
  });
  ball = { x:FIELD.w/2, y:FIELD.h/2, vx:0, vy:0, r:BALL_R, owner:null, spin:0, trail:[] };
  ballOwner = null; ownerGrace = 0;
  stamina = 1; charge = 0; charging=false;
  cameraView = 0; camFlip = 1; camZoomP = 1; camPanX = cv.width/2; camPanY = cv.height/2; viewFlash = 0;
  userControlled = null;
