{
  "name": "shaddai-backend",
  "version": "62.0.0",
  "description": "SHADDAI Production Backend - AI Agent Marketplace",
  "main": "server-production.js",
  "scripts": {
    "start": "node server-production.js",
    "dev": "nodemon server-production.js",
    "prod": "pm2 start ecosystem.config.js",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:load": "artillery quick --count 100 --num 1000 http://localhost:3000/api/health",
    "security": "npm audit --audit-level=high || true",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\"",
    "db:migrate": "node migration/migrate.js",
    "db:export": "node scripts/export-data.js",
    "db:backup": "node scripts/backup.js",
    "logs": "pm2 logs shaddai-api",
    "monitor": "pm2 monit",
    "health": "curl http://localhost:3000/api/health | jq .",
    "status": "curl http://localhost:3000/api/status | jq ."
  },
  "keywords": [
    "SHADDAI",
    "agents",
    "marketplace",
    "API",
    "REST",
    "WebSocket"
  ],
  "author": "SHADDAI Team",
  "license": "MIT",
  "dependencies": {
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "joi": "^17.10.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.2",
    "redis": "^4.6.10",
    "uuid": "^9.0.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "artillery": "^2.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "pm2": "^5.3.0",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3"
  },
  "optionalDependencies": {
    "@sentry/node": "^7.72.0",
    "elasticsearch": "^18.2.0",
    "newrelic": "^11.0.0",
    "pino": "^8.16.2",
    "winston": "^3.11.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourrepo/shaddai-backend.git"
  },
  "bugs": {
    "url": "https://github.com/yourrepo/shaddai-backend/issues"
  },
  "homepage": "https://github.com/yourrepo/shaddai-backend#readme"
}
