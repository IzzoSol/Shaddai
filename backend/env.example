# SHADDAI backend — environment variable reference (NO real secrets here).
# Copy the names you need into backend/.env (gitignored) locally, and set them
# in the Render dashboard for the deployed site. Real key VALUES live in
# Downloads\Shaddai.env / Obsidian "07 Credentials" — NEVER commit them.

# ── LLM key pool (rotates on 429; see backend/key-pool.js) ──────────────────
GROQ_API_KEY=
# Optional extra Groq keys for rotation: GROQ_API_KEYS=key1,key2  OR  GROQ_API_KEY_2..9
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# ── HuggingFace image key pool (rotates on 401/402/403/429; see backend/lib/hf-keys.js) ──
# Set the 5 rotating HF keys the owner has. ANY of these forms works:
#   (a) five numbered vars (recommended on Render):
HF_KEY_1=
HF_KEY_2=
HF_KEY_3=
HF_KEY_4=
HF_KEY_5=
#   (b) OR one comma-separated list:
# HF_TOKENS=hf_aaa,hf_bbb,hf_ccc,hf_ddd,hf_eee
#   (c) OR a single legacy token:
# HF_TOKEN=
# HUGGINGFACE_API_KEY=
# NOTE: If NO HF key is set, image tools still work via a keyless Pollinations
#       fallback — but rendered quality/reliability is best with real HF keys.
# NOTE: Users may also pass their own key per-request (BYOK) as input.hf_key.

# ── Misc ────────────────────────────────────────────────────────────────────
# PORT=3000
# ADMIN_TOKEN=
# OLLAMA_API_URL=http://localhost:11434
