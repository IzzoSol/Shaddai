06188898815357084,"book":0.043604560249274206,"proactive":0.08589119932930386,"reactive":0.08589119932930386,"choose":0.1400532013659868,"whatever":0.04691247829873068,"method":0.07389009374143735,"become":0.09035927950195356,"little":0.03584748909351027,"bit":0.046024389507260406,"better":0.046024389507260406,"competitors":0.08589119932930386,"gt":0.11036022585171629,"great":0.034911372710864176,"way":0.02948072596249114,"us":0.10611931506357242,"end":0.05637530078790022,"segment":0.08589119932930386,"chris":0.04784859468137678,"ve":0.03788677697783784,"made":0.04216089644881646,"aware":0.06686989700534032,"painfully":0.08589119932930386,"bad":0.05486879141747381,"letting":0.0700266006829934,"programs":0.07389009374143735,"best":0.042867685829607316,"tell":0.037353998463936694,"right":0.029150926743057106,"now":0.027590056462929072,"memberships":0.08589119932930386,"here":0.07074621004238163,"youtube":0.05486879141747381,"participate":0.0700266006829934,"support":0.0580254950951269,"channel":0.06686989700534032,"dollar":0.1477801874828747,"month":0.0700266006829934,"patron":0.0788710025932068,"level":0.059849700269243286,"member":0.0788710025932068,"gives":0.0700266006829934,"access":0.07389009374143735,"exclusive":0.0788710025932068,"videos":0.059849700269243286,"saying":0.08720912049854841,"love":0.03683712618497771,"content":0.09767646354568843,"please":0.0580254950951269,"keep":0.0580254950951269,"doing":0.07367425236995542,"cuz":0.04019873089920731,"quote":0.04784859468137678,"ana":0.08589119932930386,"lappe":0.08589119932930386,"she":0.043604560249274206,"says":0.05100529835902988,"every":0.04019873089920731,"spend":0.0700266006829934,"vote":0.0700266006829934,"kind":0.04082839794527975,"paraphrasing":0.08589119932930386,"supporting":0.08589119932930386,"music":0.035373105021190815,"hope":0.06188898815357084,"win":0.0642009420749403,"able":0.09204877901452081,"make":0.030159790860949956}},{"id":"doc_1785765215613_7k08ba_c10","text":"to drown out all the charlatans, all the people of low value, of low experience. And for that, I appreciate you. &gt;&gt; Another way you can support is just subscribing to the channel, and that goes a really long way. &gt;&gt; So, if you can do that, I appreciate it. Thank you.","t0":2000,"t1":2021,"tsReal":false,"tfIdfVector":{"drown":0.2676021384727876,"charlatans":0.2676021384727876,"people":0.07817813949324673,"low":0.40004818946241244,"value":0.19282098407213855,"experience":0.17564257066721065,"appreciate":0.4604231225449262,"gt":0.3438377001470432,"another":0.15543040687181406,"way":0.18369996863232296,"support":0.18078390678729925,"just":0.06662631166022202,"subscribing":0.2676021384727876,"channel":0.2083394757299538,"goes":0.13585412313471137,"really":0.09082246371944892,"long":0.13585412313471137,"thank":0.19282098407213855}}],"tsMode":"estimate"},{"id":"doc_1785765215770_m53hnx","name":"futur_build_brand_people_remember","text":"The human mind once expanded does not shrink back to its original size. And this is like many things. When you find out that these self-imposed rules that you live by are actually just that, self-imposed and not real rules, they're not laws, that you start to be more free. So, if we want to learn more about ourselves, we need to put ourselves in a position where we're explaining to people what it is that we know, think, and believe, &gt;&gt; [music] &gt;&gt; and judging by their reaction. And if you get enough feedback from different types of people, &gt;&gt; [music] &gt;&gt; you might discover something you weren't even aware about yourself. &gt;&gt; Chris. &gt;&gt; Yes, sir. &gt;&gt; Welcome back to the show. &gt;&gt; Appreciate it. &gt;&gt; 2026. Big things happening. You just launched uh a new workbook Unblend Yourself. Tell me a little bit about what inspired that. &gt;&gt; Unblend Yourself comes from philosophically this idea that we have been socialized to blend in, to get along. &gt;&gt; Mhm. &gt;&gt; And depending on what culture you come from, it's stronger in some than others. But we're wearing, in my opinion, a very uh so, for some people, a professional mask. You show up, you say certain things, and you play your cards. You don't try to upset anybody. And then if you do this for long enough, you forget about who you are, what your core beliefs are, and you're or you're afraid to go against the grain. And this is amplified across social media. We are so fearful of saying our thoughts, expressing ourselves in our truest self, dressing the way we want to, cuz we're afraid of the backlash. So, Unblend Yourself is culmination of the last 3 years of research, testing, experimenting in in virtual and in-person, in real life, workshops, where I'm testing concepts to help people figure out this like figure this out for themselves. Like, who were they Who were they meant to be in this lifetime? Who were they when when they thought to themselves when they're 7 years old, this is what I want to be when I grow up, and something happened to that plan. &gt;&gt; Mhm. Like, did you always have the thought of making this book versus like a sales book, or like how did this come together? &gt;&gt; I realized that my ability to teach as many people as I want is finite if I do it as an in-person experience or even through through the price barrier. But, I believe this is fundamental to our overall well-being, our sense of self. I want to be able to do something that's a standalone thing that can be done at your own pace in the privacy and comfort of your own home that you can go through and ask yourself these deeply personal and profound questions that require a really kind of contemplative reflective moment. And, it's not always conducive to do around people on a certain timetable. So, I recommend people go through the book at a certain pace that they feel comfortable with. And, the goal is not to try to finish it as quickly as possible, but to learn about things that you kind of buried way deep inside of you and to have some honest conversations with yourself. &gt;&gt; Mhm. When did you start to unblend yourself? &gt;&gt; It's been a progression of exploring is it safe? I'm going to be okay. I think for me doing video with Jose in was how I was able to do this at scale. So, prior to that point in time, it's not like I was sitting here trying to fit in. I've always been intrigued by this idea of pushing buttons and using the things I say, my actions, and the way that I dress to kind of push people's buttons. And, this has happened, but now it's happening at a much larger scale. So, it's kind of that that expression of you can't put the genie back in the bottle. So, you do it in measured steps. Like, if I showed up and dressed like this and said these things, what what is the consequence of that? And, like like many things, there's a quote. The quote is something like the human mind once expanded does not shrink back to its original size. And, this is like many things. When you find out that these self-imposed rules that you live by are actually just that, self-imposed and not real rules, they're not laws, that you start to be more free. &gt;&gt; Mhm. &gt;&gt; It's it's this classic story of a dog who who wears electric shock collar and when they approach the perimeter to a fence that they're not supposed to go beyond, it sends them a little electric signal. After a while they learn that there's a perimeter and you can just take it off and they never cross that boundary. And the same as about elephant who's one since childbirth is is held by chain and then eventually it's just a string and they never push past. We are like that. We learn really fast about what we can and cannot do according to certain societal norms and then we place small for the rest of our lives and we never realize that once we leave the city where in which we we grew up in or we leave the group of friends that we thought this is my core group I must need them always or the job that we've always had. We learn that the world's much bigger. There's a lot more to us to give and I think that's one of the most liberating things. &gt;&gt; With Jose, I guess what was that chain that you had to let go? Like what was holding on to you? &gt;&gt; I think the biggest hurdle I had to get through was if I am myself what kind of negative impact is it going to have on my business? Cuz at that point in time I'm still running a service design company doing really big projects and if I say this, does it mean that I lose that? And that was the thing I need to figure out. So a couple things to learn in that process. And number one, nobody's really paying attention to you. In our own little bubble, I think we we falsely believe we're the most important thing in the world because we have no other thing to reference. We're always thinking about ourselves. We're looking at ourselves. We're just dealing with ourselves most of the time. And we don't realize clients are busy. They're thinking about themselves. So they're not sitting there looking at every social post that you make and just listening to every podcast like, oh my god, we disagree politically. We can no longer work with that person. Unless you do something super sensational in a in a way that's not good for you. And and number two is there's a wider level of acceptance for you than you think. So even if they were paying attention what do I inevitably happen is as you show more of yourself, some people get to say I like that guy or I like her or I don't like that person. And I think that's a good thing. People are so afraid of alienating everyone that they wind up saying nothing to everyone and and they're just blinding themselves to into oblivion, into irrelevancy. So, when you say something and you say something that is based on your convictions, not to say it's to rile people up. I'm not saying to be a contrarian, to be divisive, but to say things that have meaning to you. It should both compel and repel. It should compel people to say, \"Yo, I get your vibe. I get what you're putting down. I want to be around you. This is cool. Let's chop it up sometime.\" And it should repel the people who are like, \"I don't like the way you think. I don't like that expression of whatever.\" For example, sometimes I wear fashion that is unpalatable for some people. Uh if I wear some kind of weird skirt short thing, they're like, \"Well, I don't I don't like that. I don't get that.\" Or some crazy color or floral print. For some people some straight people they might think that shoe's nasty. Like, \"You can't do that.\" Or if I talk about therapy and how that's been one of the biggest return on investments I've ever had, they're like, \"Well, don't bring your therapy agenda to this conversation. Everybody needs it.\" I never said everybody needs it, but if you're searching and you're lost, it's worked really well for me. I recommend you give it a try. That's all it is. I'm not trying to impose anything on anybody. For the people who feel called, try it. If not, no worries. Find whoever you think is most aligned with the way that you want to learn. &gt;&gt; So, it was interesting because as you guys know, I work in behind the scenes with the future, but when I get the comments of people that like that dress like you're 50. &gt;&gt; You do? &gt;&gt; No, when people comment to you. Like, \"Oh, like dress your age, bro. Like, why are you wearing a hat?\" But, it's like being spending enough time with you I've been in situations where we've gotten into a car or cab in a different country and then the guy would be like, \"I love what you're wearing, bro.\" Or going through TSA and people like, \"Dude, are you a famous singer?\" And just a different reaction that you get from people just by the way you dress and how you show up. So, it's definitely helped me as I'm growing into my own personal journey with growing personally, but then also fashion. So, brings me to an question is I think a lot of us get stuck in a place where we want to make content as we grow a personal brand, but we talk about what is it that we do versus who we are. So, like how do we how do we navigate that road? &gt;&gt; Okay. Some very different things. Before I answer that question, I want to talk about the comments, right? &gt;&gt; Okay. &gt;&gt; Everyone has an a-hole and everyone has an opinion. That doesn't mean I want to see either. Let's just put that out into the universe, okay? And everybody needs to know that. And sometimes they both stink. Now, getting into it. So, I used to not dress as maybe as progressively as I do today. And just the act of wearing a hat bothers people. Like, \"Oh, no one would take themselves seriously. If you walked into me, I would never hire you.\" Bro, trust me, you don't have enough money to hire me. So, let's start there. You probably have never hired anybody. And these kinds of ideas about asking people to meet you where you are to be able to have the pleasure of your company is ridiculous. We all come in different shapes, sizes, and have different preferences about how we carry ourselves. To each their own. Especially in this country about self-expression and freedom, your First Amendment right. We should accept people for who they are. Or we should just decide this is not for me, and that's totally okay. But to project your your values and your aesthetic onto people is just ridiculous to me. Nobody asked you. Nobody cares. So, people would say things like, \"Your hat.\" Or \"Who do you think he is? He's trying too hard.\" Or \"Every time I tune in, there's another necklace, and it's just getting out of control.\" &gt;&gt; Don't forget the skirts. &gt;&gt; Well, well, they're not even there yet cuz I don't have enough episodes with that just yet. But there's like, \"Oh, the chain.\" Like, \"Oh, he's like You can tell he's poor cuz he's dressed like he's poor, and this is what poor people look like. I promise you let's bring those people on the show. You line up here and let's sit here and we can talk about um I don't know, net worth? We can talk about accomplishments. We can take it down any dimension you want and chances are you you probably have me beat in a couple of categories, but you kind of project that energy into the world. I think it just consumes you. So, most of the times I look at that and laugh. Here's where it gets real interesting. When you're in real life and people start saying that thing, now you're dealing with the heat in real life. But people are very brave behind your back. They're not so brave in front of you. Here's a classic example. I think you were there. We're at Ford. I think it's 2 years ago and at their at their main event, okay? Ford is uh run by Neil Dingra. It's for mortgage professionals and real estate people, right? My buddy Trevor, Trevor York, is there. He goes, \"Chris, Chris, I love the way you dress, but I don't fully understand it.\" And he's he's giving me a little hard time. As a straight white guy, he's giving me a hard time, but with love. I Trevor and I we we have a great relationship, but he's like I said, \"I could never pull off that man bag that you're wearing, that purse.\" And I said, \"Are you sure?\" And why don't you try it on? And he would try it on and all the the women around here that part of the staff was like, \"Oh, Trevor, you look so good.\" He goes, \"Do I?\" So, that's a a pre- presumption of reception of how people would read you and also a limiting belief about what you can and can't pull off in this life. And the next thing he would do is say, \"Oh, what is that uh did you take that belt buckle off the airplane? Like do does TSA know about this?\" Trying to give me a hard time. I'm like, \"I'm good with it. You You You want to play? We can We can dance, right?\" And and and we have these conversations about what makes you comfortable uncomfortable. And now, this is great cuz Trevor if you're ever watching this his game has changed. He's dressing differently and he's like sending me DMs like, \"Hey, is this a good fit or not?\" And so, I I like that for each person. It doesn't have to be about fashion. It could be, \"Oh, you never thought you could drive that kind of car.\" Or you never thought you could live in that house or that neighborhood or date that kind of person. We have so many limiting beliefs. One of the things I would that would really bother me about some of my friends then they would say something like this. She's so out of my league. I'm like with that attitude for sure she is. Like what do you mean out of your league? You mean that some people who are born more asymmetrically beautiful or whatever it is that you think, therefore you're less than? She did nothing to earn that nor did you if you're like a super stud athlete. Oh, that's mostly genetic. I respect the game that you you worked worked out and you're focusing on skills. That's cool. I can look up to that. But the rest of it like why do we believe someone's in or out of our league? That's a value statement that's just full of judgment that that really bothers me. So it's these kind of beliefs. I can't wear that. You shouldn't wear that. It's really a a projection of your own insecurity and your own prejudice. And I think people need to check themselves. Let's get into your question now. Your question is why do people talk so much about what they do versus who they are? Because there's a lot of templates out there that exist. We don't know what to talk about. We're told from very young age don't talk about yourself. Don't think about yourself so much. So what do we do? We deflect. We're like, well, nobody's going to complain if I I tell people I'm a plumber or I'm a roofing contractor or I build websites. But you know what? So does everybody else who does that exact same thing. Why should I care about you? What we're realizing is in the 21st century we have an embarrassment of choices. Where we're kind of inundated and overwhelmed with how many choices we have in the world. In fact, there's a cognitive bias. It's called the paradox of choice. That the more options that we have, the harder it is for us to make a decision. And the reason why potentially some of your clients don't choose to follow you or to reach out to you is because they can't tell why you're different than anyone else and so therefore they shut down. And you and I both know this. Anytime you need to do something you don't know about you start to do too much research and you're like, \"I'm just overwhelmed.\" That's why it just takes us too long to do something. Steven Bartlett has had this great um podcast or No, it was a keynote talk. He goes something like, \"Back when I was younger, in my 20s, I was speaking and some notable person spoke before me, probably head of state, maybe even a former president or something.\" And he says, \"There are two doors, door one and door two. And people make this mistake. Door one, you go in and it locks behind you, you can never leave. There's only path is forward and you're in that door. Door two is a door that you go in and it's not locked, you can leave if you want. And choices are like that. Sometimes we mistakenly believe that all doors are door one. You can only make this decision, you can't undo it.\" An example he gives is some friend had asked him, \"Should I quit my full-time job and start this other thing?\" He goes, \"Well, what's the consequence of you leaving? Are you able to come back or not? And either in that position or a better position or some other position?\" And the And the lady said to him, \"Yeah, I can come back.\" So, she was thinking too long about a decision that could be easily undone. And so, the greatest problem that we seem to have in modern entrepreneurial circles is we think everything's a door one situation and we can't undo. So, it's not that we make the wrong decision, it's just we make no decision. That's the problem. Getting back to why people don't talk more about themselves, culturally it doesn't feel right. We don't know ourselves. We have low self-awareness. And if we have high self-awareness, we're not quite sure what's interesting to other people. Historically speaking, we are the worst judge of our own value. I could do something, you're like, \"Dude, how did you do that? Why did you even move that there or put that thing on? How did you know that's going to work?\" And I'm like, \"Well, doesn't everybody know that?\" Yeah, well, I don't, explain it to me. And then I would explain it to you and depending on your reaction to me explaining it to you, I could think, \"Maybe I'm on to something. Maybe somebody else like you would want to know this thing. And that begins the process of understanding, \"Wow, something I take for granted is valuable to other people.\" So, if we want to learn more about ourselves, we need to put ourselves in a position where we're explaining to people what it is that we know, think, and believe. And judging by their reaction, and if you get enough feedback from different types of people, you might discover something you weren't even aware about yourself. &gt;&gt; You're so aligned with who you are, so I think it's easy for you to talk about these things cuz you're already and you do all these different things. But I think for like a lot of us, me being video production, and build my business for past 10 years around video production. When I like, \"Hey Chris, how do I make this video about that?\" You're like, \"No, that's boring. Talk about this other thing.\" And I'm just and I just I don't see it like the way that you do. For me, it's so easy like, \"Well, I can build a personal brand talking about video.\" But you're like, \"Well, that's not really building a personal brand.\" But I think for you, you're so aligned that like when you hear when you say this to me, yeah, it makes sense for you, but like I don't feel like it'd work for me. &gt;&gt; What wouldn't work for you? &gt;&gt; Like to not talk about videos. Like I don't know how to not build a personal brand around the thing that I've been doing for 10 years. &gt;&gt; Okay, let's clarify. Talking about what you do is not how you build a personal brand. You're basically doing tutorials. Nobody has any sense of who you are, what you stand for. Uh your the all the things you've learned in life is just manifested in how to. &gt;&gt; Mhm. &gt;&gt; So, if we said this, if we put a robot voice on you, but it's the exact same script, and we blur your face, would anybody be able to tell it's you? &gt;&gt; Mhm. &gt;&gt; Cuz you're not really sharing your philosophy and your ways to the world. Now, let's let's uh contrast that against some some people who have very strong personal brands, but maybe not put a lot of value into the world. Uh we were talking to Manager John earlier today. He's like, \"In the OG days, all you had to do is turn on the camera and be a personality.\" So, we got to know those people really well, and they grew gigantic accounts and have massive fandoms. But to the average person, it's like, \"What value did you give to me?\" So, the blend is Or, I'm sorry, the solution is somewhere in between the two to say like, I create a lot of value in the world. I give you a lot of utility. I'm useful. I'm helpful to you creating transformation. But, I'm also weaving in my story about who I am. So, you have a choice. Do I want your brand of video production or do I want someone else's brand of video production? The classic example I always give to, and I'm sorry if people are bored out of this until you they can understand this concept. Water's water. Water's two two uh what is it? Two molecules of hydrogen and one molecule of oxygen or something like that. H2O, right? When we put that together, we have water. Water's water. Water comes from the sky. Water comes from the earth. It comes from every place. And it's theoretically free and abundant and available. Yet, we all make this decision to go into the store and buy a bottle of water for $2 or $25 for the exact same amount. Why does one command $2? Why does one command $25? And there's The answer is the story that each bottle brings. And there's a fancy word that's called provenance, like where something comes from. This came from the Swiss Alps. This came from the Amazon River. This came from parts of Africa or the Canadian glacier. This is never touched by man. This is vapor distilled. They're all stories because marketers have learned that we need a story. Humans are meaning-making machines and we need to have meaning in everything that we do. So, if you tell the story, I allow myself to accept your meaning. So, when you don't tell your story, there's no meaning. There's no connection. &gt;&gt; So, if I wanted to start 2026, I want to start building my personal brand. I want to start telling my story. What is that first post that I would start off with? &gt;&gt; Well, you're talking about the tactics of creating something. Before we can create something, we need to know well, who the heck are you? And there's a good chance you don't even know who you are. Hence, the questions I pose in the book and the workshops, well, who are you? What are your beliefs? What are your values? And what people tend to do is they want to talk about all that they're good at, all the strengths and the beautiful things. We're very used to that. This is why people appear too perfect on TV or on on social media. It's because they're presenting their very best self on their very best day. That's really boring to me. &gt;&gt; Mhm. &gt;&gt; And it reeks of inauthenticity. So, I say to people, look into your shadow self, the things that you feel great vulnerability around, things that you might bring anxiety or make you nervous. Let's figure out how you can incorporate that into you because that makes you much more interesting. Earlier today, we're talking to manage to John. He's shared this very vulnerable story about how he bought a U-bake pizza and he didn't know he had to bake it even though it was in the title. Now, I'm ribbing him a little bit, but that story's endearing. Now, people on the other side of the camera are going to say, \"Chris, why you give John such a hard time? He's just an earnest guy trying to make it in the world and yeah, he didn't have your upbringing, blah blah blah.\" But they're going to connect to that story. &gt;&gt; Mhm. &gt;&gt; Despite how he might feel in that moment, those little quirks and the weird things allow people to say, \"You're not a perfect person. I'm not a perfect person. We might have something in common.\" I don't know about you. I'm not perfect and when I see perfect people, which they don't exist, but they present themselves to be, there's something about it feels like they're driving a wedge between me and them. My ability to connect with them is not going to be great. &gt;&gt; I hear you on doing the deep work and trying to find out more by yourself before you make that first post, but I think for some of us we get so paralyzed of even just doing the work book. Like some of us can't even make a post just to make a post. So, then you say like, \"Hey, you got to do this deep work before you make something.\" Is Are you saying that's the only way? &gt;&gt; saying that. &gt;&gt; Okay. &gt;&gt; You can make whatever you want. In fact, all over the internet there's people making whatever they want. It's not stopped them. Someone will figure it out and some of them won't. But if you want to be more intentional before you make the work, spend a minute. So, I'll give you an example. Uh what is something that you've wanted to teach, but you're not fully confident that you know how to teach it. &gt;&gt; Storytelling. &gt;&gt; Okay, so great great answer. So, storytelling. If you want to go out and teach storytelling, you could say, \"Here's what I feel about this and based on my own life experiences, this is what I know.\" Which could be a great video. But a learned person, somebody who's like much more intellectually curious, would say, \"Well, what are the top five books on storytelling?\" And kind of watch movies, read stories, and watch plays, and start to understand the invisible structure that binds them together. What is the thing that makes the top 100 films of all time great? And then you could do that research and you can start thinking about it. And then you can maybe come up with a couple of things that are obvious between these things and a couple things that are not obvious that you start to share with the world. You could do this in intimate conversation with you and another person off camera. You could do this in small workshops, virtual workshops. And then you start to see what ideas stick. Now you have something. And when you go and make content around that, something you thought about, that's going to hit much harder. Can we see the difference between these two approaches? &gt;&gt; I want to say no, because that to me feels like what you just said of like you're a how-to person. Like if you're coming if you're like looking at these books like, \"Hey, here are five books for you to go read.\" How's that different than what you said to that like to be a how-to person? &gt;&gt; Okay, these these are two different arguments we're making. I asked you, can you see the difference between someone who wings it, who doesn't do any research, and one person who does a deep dive and try to like fill in the knowledge gaps that they may or may not may not have. &gt;&gt; Okay. &gt;&gt; Which one will be more valuable? &gt;&gt; The second one. &gt;&gt; The second one. The problem is most people don't go this path as you know. &gt;&gt; Mhm. &gt;&gt; So, when you say, \"I don't know how much work I need to do.\" It's like, \"Have you done the basics?\" So, now that you have structure, right, and you've learned these things. When I say learn, I don't mean read, I mean learn. Like you can internalize it, you can share ideas. What happens inevitably is once you learn something, it gets mutated by your own brain in a good way. You say it a little differently. You you embellish this and you remove that and all of a sudden it starts to become more yours and less theirs. Now, if you were to learn about storytelling and you're teaching storytelling, one way is mechanically say, \"Here's how you tell a story.\" The other more interesting way is you tell an amazing story and say, \"Do you want to know why I did that? Here's what happened.\" That becomes part of your brand. &gt;&gt; But then don't you just become the storytelling brand guy? &gt;&gt; Yeah, that's what you said you wanted to learn how to do. Storytelling. &gt;&gt; Well, I wanted to figure out a way out that I'm I just don't become that person cuz like why So what's the difference between me being the video guy or me being the storytelling guy? &gt;&gt; Okay, what is video guy? &gt;&gt; I'm the guy that you come to when you need like videos done. &gt;&gt; And what is it that's the underlying layer that you're selling? &gt;&gt; Views, reach for my clients. &gt;&gt; Is that what you're selling? &gt;&gt; Yes. Are you sure? &gt;&gt; I thought you're just selling video production at that point. If I'm a strategist to help people get views, conversions, audience building, all that kind of stuff, I don't talk about video production at all. I talk about video strategy. &gt;&gt; Okay. &gt;&gt; That's very different. &gt;&gt; Okay, but say I talk about video strategy. &gt;&gt; Okay. &gt;&gt; I thought when you said about being building your personal brand isn't about talking about what is it that you do? &gt;&gt; That's correct. &gt;&gt; So then wouldn't I just be the video strategy guy? &gt;&gt; Yeah. &gt;&gt; So how do I move &gt;&gt; done anything to tell about your personal brand yet. &gt;&gt; So how do I get started with that? &gt;&gt; There's a couple things you need to do. Um I I've developed another workbook because I realized Unblend Yourself is dense book, it's 100-plus pages. It's deep inner work and people like their heads are melting right now. So I was thinking, \"How do I provide a quick win?\" I'll share a story. You and I were in Japan uh uh with uh 18 of our friends, some strangers and some some old friends. Uh I'm I'm I'm having a really good conversation with my buddy Chris Sergio. He goes, \"Chris, I love what you're doing. Can I give you some advice? I'm like, sure, please. And he's a brilliant guy, so of course I'm going to take advice from him. He said that what I find to be effective is when there's high frequency of exercises, but low intellectual lift. What that means is instead of giving us a big thing to figure out that we don't talk about for 3 days, give us lots of little things, quick check-ins, so we feel like we're making progress on things, little tiny tasks. And it's very different than how I think. I'm a deep diving kind of guy, and these seemingly complex problems for me are not that complex, but for for other people it's very complicated. So I took that to heart. So when I went to do the next workbook, I had the goal of how do we lower the lift, the mental lift, and how do we make it fast, fun, and easy that somebody can do in 30 minutes and feel like they have some success. So what I had to do is develop a whole set of different exercises, and it gave me a lot of clarity that dare I say, I might actually even like more than the 100 page book. Okay, so I'll share it with you. There are three things. We'll call this your unblind essence or essentials or foundational layer or something like that. And there are these three things. The cool thing is you only need to know one of these things to figure out the other two. So what I want you to imagine is either a triangle or three overlapping circles, the Venn diagram. Okay? Where they meet in the middle is where you are in your personal brand. And they are what is the one thing you want to be known for? And I'd like to reduce it down to a word if possible. There's some conditions there. So first, what's the one thing you want to be known for? Number two, who's the enemy? What are you on a mission to rid the world of? What do you want to eradicate? And this, there are only so many versions of this, right? So it's universal. There's probably 12 universal concepts, I just made up the number, that everybody's trying to get rid of, like hate, poverty, whatever else that they're trying to get rid of the world of, right? Judgment, let's say. And then the last one is and it's the bridge between these two things, your your one thing, the enemy, the the thing that you're trying to eradicate the world of, and your call to arms or your rallying cry, the phrase that when you say activates your audience and the community. And so, do you know the one thing you want to be known for, Rodrigo? Or of these three things, what do you think you're clearest about? &gt;&gt; The one thing I want to be known for. &gt;&gt; Which is? &gt;&gt; A YouTube strategist. &gt;&gt; As a YouTube strategist, okay. &gt;&gt; That's what I want to work on for 2026. &gt;&gt; Perfect. YouTube strategist. The The criteria now we have to ask ourselves this question. Can you own this space? Because the world rewards number one, not number two, three, or four. If you cannot own this space within a relatively short amount of time, and when I say short, between one to two years, then you should not try. Something from Seth Godin's book The Dip is we should predetermine if we're going to be successful, and once we determine we can be successful, we never quit. What people do is they don't think, they try things and they quit, they think and they try things and they quit, they never get anywhere. So, if you look up right now on the internet, type onto Google or Gemini or anything and say, \"Who are the world's most for for foremost thought leaders in the in the YouTube strategy space?\" Get a list, double-check your homework, and say to yourself, \"Can I with intentional effort overtake them in a year's time?\" If you think you realistically can, I would suggest you go for it. &gt;&gt; I understand &gt;&gt; What do you mean? &gt;&gt; one thing, right? But why do I need an enemy? Like, if I'm just trying to be the like the YouTube strategist, why do I need an enemy for that? &gt;&gt; rid of something in the world. &gt;&gt; Mhm. &gt;&gt; Because we are more united in a common enemy than we are in a common friend. And all the best brands in the world, as far as I know, they have an enemy. And we can go through this exercise if you we say like here's a clear clear brand, and what are they trying to get rid of in the world? If we can't identify that, there's a big part of the triangle that's missing. &gt;&gt; Can you give me an example? &gt;&gt; Yeah, pick a brand. We'll try this live and freestyle. &gt;&gt; One of your favorites. &gt;&gt; Who? &gt;&gt; Louis Vuitton. &gt;&gt; Louis Vuitton. Okay, Louis Vuitton is a brand. What is the one thing they want to be known for? &gt;&gt; You're asking me that question? &gt;&gt; Yeah. &gt;&gt; Oh, luxury goods. &gt;&gt; They're trunks company, by the way. &gt;&gt; That's what they're known for, being a trunk company. &gt;&gt; literally what they say all the time. We're not a fashion company, we're trunks company. We make trunks. And trunks are bags, they're interchangeable those words. &gt;&gt; Mhm. &gt;&gt; That's what they're known for. &gt;&gt; Okay. &gt;&gt; And you know why they say that? &gt;&gt; Why? &gt;&gt; Cuz that's what they sell the most of. &gt;&gt; Mhm. &gt;&gt; So, let's Okay, side detour here. Why did they appoint Pharrell Williams, who's not a designer, to run one of the most uh profitable largest fashion houses in the world, LVMH group, right? &gt;&gt; Right. &gt;&gt; Why? &gt;&gt; For clout. &gt;&gt; Well, he's been designing fashion that has a lot of mixed reviews. I love Louis Vuitton as a brand. I've yet to purchase a single thing that Pharrell has done, except for &gt;&gt; Prior to him. &gt;&gt; There's a gentleman named Virgil Abloh who passed away. I'm desperately going through the back catalogs of Grail to find pieces he's designed, because he's an exceptional designer. Okay? It's because I'm not looking at their books, they don't disclose their books. I imagine a very small percentage of their sales accounts for fashion. The rest of it is in bags and trunks. &gt;&gt; Mhm. &gt;&gt; So, they're very clear, this is where we make our money. So, what did they want with with Pharrell? The bags don't change that much. But the fashion does. So, what Pharrell can do is he can direct attention. If you are a nut like myself and you look at fashion fashion week in in New York or or Paris, you can see all the shows going. And if you look at all of them like from Dior to Saint Laurent, and you look at them, the ones have the most views LV. Because he brings superstars to the show and he's thinking about it more as like pop culture theater and not just pure fashion. The most recent runway for the winter season, he built a Japanese home and put artificial turf and did this super beautiful lighting. I was like, that is very different. That is different than somebody say, let's just do our runway here in the middle of a factory. And like, I get that. There's an aesthetic to it. But this is theater. And he's spending a lot of money building these things to make us want it, to make it part of the conversation. Let's take another quite polarizing character. Jaden Smith, Will Smith's son. That Will Smith. Yeah. Jaden has become the first creative director for menswear for Christian Louboutin. Okay? Louboutin, as far as I know, doesn't even make fashion. He makes really amazing shoes. Why do you put this young nepo kid in charge of this brand? Well, we're all talking about Christian Louboutin for a minute, and it's all over the place. And he's a polarizing character who knows how to get attention. &gt;&gt; Right. &gt;&gt; Right? And you don't think Christian Louboutin knows what they're doing? Like, you'd be a fool. And I actually, for the first time, want to buy something from Christian Louboutin because of what Jaden's done. I'm not saying all of it's good. It's not, but it's not all meant to be good. &gt;&gt; Mhm. &gt;&gt; Now, what they understand is this thing called the halo effect. Which is kind of like what it sounds like. We are going to direct your attention to something, then you check out the rest of the things, and the likelihood of you buying the rest of the thing is great. So, they can make five fuzzy boots and not worry that anybody's going to buy it. But because it's being talked about. That's what matters. &gt;&gt; Mhm. &gt;&gt; Okay. So, Louboutin is known for trunks. What are the What is their enemy? Maybe you can say like fast fashion is their enemy. I'm not saying they're saying that, but you can probably think that that's their enemy. And in fact, all luxury brands hate fast fashion. &gt;&gt; Mhm. &gt;&gt; And I hate fast fashion for a lot of different reasons. So, what is their rallying cry? I I don't know what it is, but you start to map this out. If we spend enough time thinking about it, we can probably figure it out. For all clearly defined brands, we can figure it out. &gt;&gt; I guess it would be easier if we put this to a person versus a a company. &gt;&gt; Okay. &gt;&gt; Let's do Brian Johnson. &gt;&gt; Oh. Glad you brought that up. Are you familiar with Brian Johnson? &gt;&gt; bit. &gt;&gt; Okay. He He is the guy who who I guess for lack of a better term looks like a vampire. &gt;&gt; Yes. &gt;&gt; Uh sometimes he's the considered the most measured man. He spends over million dollars a year biohacking so that he he doesn't have to age. So if you say, \"What's the one thing he wants to be known for? What's the one keyword?\" What do you think that word is? &gt;&gt; [sighs] &gt;&gt; Not dying or death. &gt;&gt; Okay, but the word would be something like longevity. &gt;&gt; Longevity. Okay, I see the the twist there. Okay. &gt;&gt; Okay, so longevity. He wants to live for as long as possible. And you can say aging reversal. Like he he his biological age is going backwards. His chronological age don't begin to stop, it goes forward. So when he does all his chemistry and they look at it and his biology, they're like, \"Wow, you're not 48, you're 36.\" And he takes a thousand vitamins. He's doing all kinds of radical treatments, red light therapy. He's doing everything he can to to grow backwards in his age. So he wants to be known for longevity. What's his enemy? What's he fighting against? What does he want to get rid What? &gt;&gt; Death. That makes sense. Do you see how they're connected now? He wants to be known for longevity and he doesn't he wants to get rid of death. Uh Another fancy or $6 word for death is entropy, where systems start to decay. That's called entropy, right? So longevity and death. What is his rallying cry to let everyone know we're on the same mission? Let's go do this thing. Do you know what he says? &gt;&gt; No. &gt;&gt; He says, \"Don't die.\" And it's perfect. So I want to be known for longevity, my enemy's death, my rallying cry is, \"Don't die.\" So he has a conference, the Don't Die Conference. He might have a package of supplements called Don't Die. So now it becomes really clear and he can build brand extensions from this and it's super clear now. Right? So whenever you think of longevity, he owns that space now. So there are a lot of other people like my friend Dr. Ken Vu and he's trying to like be for longevity. I'm like I can't remove Brian from my mind. So you're going to be number two and I'm pretty sure people in the space know Brian Johnson, but they don't know Ken Vu. And that's a problem. &gt;&gt; Okay. &gt;&gt; Now, there's mathematical parts that support this. The number one leader in any vertical is three times bigger than number two. Three times. &gt;&gt; Wow. &gt;&gt; Number two is three times bigger than number three. So basically, the three top players in a market control the entire market and there's like scraps for everybody else. So the remaining 97% fight for crumbs. If you can't be number one, don't even play. That's my opinion. Who's Who landed on the moon? Who's the first person on the moon? &gt;&gt; You know I'm sure. &gt;&gt; Who's number two? &gt;&gt; No idea. &gt;&gt; Who's the first person to run the 4-minute mile? &gt;&gt; Roger Bannister. &gt;&gt; Who's number two? &gt;&gt; Couldn't tell you. &gt;&gt; Right. &gt;&gt; Yeah. &gt;&gt; So let's say for example, who is the person who's going to teach you to unbrand yourself? You should say my name and then who's number two? We don't care. That's the problem. There's There's a And I'll give you the example, too. &gt;&gt; But I feel like that's so discouraging. &gt;&gt; Why? You have a system of thinking designed for failure, my friend. &gt;&gt; Well, you're saying like hey, if you can't be number one, then you shouldn't even try. &gt;&gt; even try. &gt;&gt; So like if I look up on YouTube and like the the top four YouTube strategies, you're like oh don't even bother. So then what do I do? Just &gt;&gt; Pick another lane. &gt;&gt; So don't become a YouTube strategist. &gt;&gt; Find a different lane. Simple as that. &gt;&gt; Okay. &gt;&gt; So you say like Chris, can you be number one personal branding? Maybe, I'm not sure, but I can definitely be number one in unbrand. &gt;&gt; Okay. &gt;&gt; See, this is just it's words and words do matter. &gt;&gt; Mhm. &gt;&gt; When you think of why, who do you think of? &gt;&gt; Simon Sinek. &gt;&gt; Who else do you think of number two? When you think of vulnerability, who do you think of? &gt;&gt; Brené Brown. &gt;&gt; Who do you think of number two? That's what I'm saying. If I cannot out research and storytell and do TED Talks that is one of the 10 most viewed TED Talks in the world and compete with Brené who's written so many books, who's been on Oprah, who's been on every single thing you could think of, I'm not going to try to win that game. I'll try to win a different game. Maybe I use the word shadow self. Right? Um do Are you familiar with the writer named Ryan Holiday? &gt;&gt; Mhm. &gt;&gt; The Obstacle Is the Way. Uh I'm spacing. He writes a lot of books on on learnings from Marcus Aurelius and and Seneca the Stoics, right? &gt;&gt; Mhm. &gt;&gt; So he wants to be known as the Daily Stoic. So when you think of Stoicism, he wants you to forget about Marcus Aurelius and Seneca. I forget the third person. See, you can never remember the third person. And so now he wants to be the modern-day Stoic. And he's working real hard to own that. So if I want to go in like, \"Hey, I'm pretty Stoic.\" Like do I want to out Stoic that boy? Probably not. I'm not going to write five books. &gt;&gt; Okay. &gt;&gt; You see what I'm saying? &gt;&gt; So like put this into for myself. So like I would go on YouTube. I want to become the YouTube strategist. And for me it's then find a niche within YouTube that I could be that strategist for. &gt;&gt; Possibly. &gt;&gt; Okay. &gt;&gt; It only takes one dimension for you to then change the game. So one level of specificity will will change it for you. &gt;&gt; Right. &gt;&gt; I want to be the YouTube strategist for Latin America. Boom. You can own that. &gt;&gt; Okay. &gt;&gt; Only adding one more dimension. &gt;&gt; Okay. &gt;&gt; it takes. And and I want to tell you something. You're like, \"It's discouraging.\" I don't see it as discouraging at all. Because if you're number one, it means you're number one and nobody can take it away from you. You see? The the coin has two sides. You only look at the side of like, \"Well, that doesn't That's not cool.\" But the good side to the coin is once you own it, it's kind of hard to undo it. Because the human brain works like this. Once something occupies a space in your mind, it's very hard for you to undo that. And not to get political, but Trump is great at doing this. When he calls Hillary Clinton \"Crooked Hillary\", we can't stop thinking \"What? Is she Is she crooked?\" Like you have to double-check yourself, cuz he made the name stick. &gt;&gt; Mhm. &gt;&gt; Right? This is the power of words. When it's associated with something, it's very hard for us to uncouple it. So, what you need to do is think \"What do I want to be associated with?\" And kind of own it. And if I can't, I'm going to work like a dog to own it. &gt;&gt; So, is your book teaching you how to find this one thing for you to be known for, or is that there's are there different elements to the personal branding and what you call it? &gt;&gt; than that. There's seven points, but I realized in trying to make it simpler, is it simple enough? So, I've done this a couple of times now where I'm like, maybe I should just focus on the three and not the seven. &gt;&gt; Mhm. &gt;&gt; But as far as I can tell, there are seven observable traits that a personal brand has, or actually any brand has, right? &gt;&gt; What are those? &gt;&gt; But I focus on the three. I don't want to talk about that. &gt;&gt; Okay. &gt;&gt; It's going to make it more complicated, cuz can people in this room remember what the three things are? What are they? &gt;&gt; What's the one thing you want to be known for? Who's your enemy? And what's your call your crying What do you call your &gt;&gt; You can call them many things. Say whatever you want. &gt;&gt; call out, or your crying &gt;&gt; Your your rallying cry. &gt;&gt; cry. &gt;&gt; Your call to arms. &gt;&gt; Okay. &gt;&gt; Um your slogan, whatever it How are you Your phrase that activates your audience, your community. &gt;&gt; to say your slogan. That's probably the easiest one to remember. &gt;&gt; Yeah. You can say whatever you want. But you don't remember the concept. Now, if I were to bomb you with seven, you probably were like, \"Uh, I don't know what to do.\" So, I'm trying in earnest to follow my friend Chris Sergio's advice. Low mental lift, high frequency. &gt;&gt; Okay. &gt;&gt; So, the rest of the book will cover the other seven, but it is a workbook, it's not like a book book. And you do something, you'll start to see patterns. &gt;&gt; Yeah. &gt;&gt; So, play games with you. &gt;&gt; I mean, I have a copy here and I've been playing around with it. Definitely something like when I'm on the airplane, I've been going through this. So, this definitely helped a lot. I'm excited for the next one as well, but I think you did a good job of putting this together. &gt;&gt; Thanks. &gt;&gt; I do see one thing here. You said there's like three principles to personal branding. What are those? &gt;&gt; I'm a little afraid to tell you, but I will tell you because the principles are philosophies and ideas. They're not actionable. They are number one, you have to be intentionally or meaningfully different. Because if you're the same as everybody else, then you might as well not have a brand. You have a bland. Number two, you have to have the courage to be disliked. Uh that sounds really good cuz it's coming from a book title that I also like a lot. So, if you're different, different gets smashed. Different gets ridiculed. Different is misunderstood. So, we know as soon as you have the courage to stand up, people are coming after you. So, then you have to have the courage to be disliked. I'm different and I'm cool with that. Right? Number three, and this is the one that's going to surprise most people, is more than 50% of our brain is dedicated towards visual processing. Like when I look at you from afar, is that Drigo? Is that my buddy? Or is that some other person? Should I be scared? Is that friendly? Is that an aesthetic combination of things? So, more than 50% of our brain is dedicated towards visual processing. So, to tie it to how we began this conversation is the way I present myself visually signals to other people really quickly before words are formed a feeling. And so, the principle number three is you have to be aesthetically discerning. If I were to show up in in an a potato sack with flip-flops, you might think, \"Oh, Chris is really earthy. He's a man of the people. He's keeping it real humble right now.\" Or somebody else might think, \"Oh, you couldn't be bothered to show up for this? I showed up for you. I can't take you seriously. So, what we're doing is unbeknownst to us, we're signaling to people all the time, who are we? How should you perceive me? So, you walk into a room and you have a perfectly groomed beard and you're wearing a super sharp $10,000 Italian suit that's tailored. And you walk into a room, people are going to think, oh, this guy he he must be an important person. You come in there with shorts, cargo shorts and a t-shirt with holes in it and and sneakers, who let this kid in the room? Where's security? You can literally be the CEO, but people will interpret you as a certain thing. &gt;&gt; We're talking more. &gt;&gt; Whatever. So, what I tell people is this, your clothes, your packaging is a tool. I want to reframe it. Your clothes are not clothes, they're tools and tools are designed to solve a certain job. A wrench is pretty good for turning bolts or nuts, right? A screwdriver is pretty good for turning screws. A hammer is pretty good at breaking things and driving nails. You probably should not use a hammer to turn a nut. You probably shouldn't use a screwdriver to drive a nail. We That makes sense, right? Does that make sense? Just say yes and I'm done. &gt;&gt; Okay. So, the question for you is, the tools that you have, what job are you trying to solve? This is a really important question. So, like, if you're working in the kitchen, an apron works really well. And if you're working in a car, a jumpsuit works really well, dark one. If you're working in a hospital, scrubs work the best. So, when you're dressed and you're going to step on stage, what job are you trying to solve? &gt;&gt; Well, a lot of us aren't stepping up on stages. &gt;&gt; Well, I'm saying if you are, this is hypothetical. &gt;&gt; See, I'm feel I feel conflicted hearing that because it goes back to the start of this talk when we talked about what people write in the comments about like what you're wearing. Like, hey, I wouldn't hire you. So, you're saying, hey, if you're going going business meeting and you're wearing your long skirt or dress, but you're like, \"Hey, I'm &gt;&gt; the question. If you answer the question, you don't have to figure out the problem. &gt;&gt; entertain and inform the people that &gt;&gt; With your clothes. &gt;&gt; Yeah. I guess I'm trying to impress. &gt;&gt; So, when you're trying to impress, most people say you're trying to be professional. You want to be taken seriously. &gt;&gt; Okay. &gt;&gt; And so then, what are the tools that you would use for that? Of all the different kinds of fits you can put on, most people say, \"Well, sport coat, trousers, um loafers, maybe a tie, maybe. We don't know. Right? &gt;&gt; Right. &gt;&gt; And that would be a pretty reasonable thing. Like, I'm trying to be professional. I'm taking this seriously. I wish for you to take me seriously, and we adopt the corporate speaker's uniform. Perfect. Right? Everybody agree? &gt;&gt; Okay. The problem is, you're also telling them, \"I'm like every other person that's on this stage. I'm actually not that special. Maybe you guys should ignore me. Cuz what I'm going to say is going to be like what everyone else is saying. The way they deliver it is the way I'm going to deliver it. You know how they start with this? I'll start with that. You know how they conclude with this? I'll conclude with that. You see their tone? I will adopt that tone. So, you're inadvertently signaling to everybody by adopting the corporate uniform, \"I'm like everyone else. Please don't pay attention to me.\" This hurts, cuz a lot of people dress this way. So, my intention is different because I'm maybe more secure in myself, I'm more self-confident. I could give a flying rat whatever what you think about what corporate looks like. What the What job I'm trying to solve is, I'm going to be different. Whatever you heard before and after may or may not matter, but this will not be the same presentation. I'm not the same person. I actually care a lot about design and intentionality, and I'm going to tell you why it's an advantage to be different by proving it to you, not just talking about it. Imagine if I came on stage and I'm like, \"Dare to be different.\" And I look like every single other person. The best way to un-blind yourself is to look just like everyone else. There would be a mismatch, a misalignment between message and delivery. You see the problem. &gt;&gt; I do. I think you used the tool very well there. Put the hammer to the nail. &gt;&gt; Hammer to the nail? &gt;&gt; Yeah. &gt;&gt; Right? So, you see if you just let me lead you, you I'll take you to the promised land. Now, here's the thing. Are they going to light me up in the comments? &gt;&gt; Probably. &gt;&gt; For sure. No, not probably. I would take odds and I would bet that yes, they're going to light me up in the comments. But you know what they don't pay attention to? Is how many people say positive things before, during, and after that make the negative comments seem tiny, relatively speaking. So, I told you before my philosophy, my ideas are meant to compel and to simultaneously repel. I know if I do something doesn't repel people, I'm not doing anything of note. If you play it really safe, if you drive down the middle lane always at 55 mph, you're not going to offend nobody. You're not going to get You're not going to break a speed record here. I'm I'm here to break things. So, somebody during our conversation at dinner I said so what's what's this all about? You're not on stage right now, right? Why Why you look like this? What What job are you trying to solve? They're trying to test me. Do you know what I said? &gt;&gt; Tell me. &gt;&gt; Guess. Can you guess or not? You don't have to. &gt;&gt; Give me Give me a second. What did he say to you? &gt;&gt; Right? So, like now I'm not on stage per se, like I'm just out for dinner. &gt;&gt; Chris, why are you doing this? &gt;&gt; Yeah. And I like being tested, by the way, cuz that caught me off guard, too. I'm like, \"Oh, I wasn't It's just theory, man. You don't turn the lens back on me.\" And I had to think real quick and I said \"So, here's something you don't know about me. I hate social events. It took a lot of energy for me even to decide to come to this. Even to say yes, I'll be there. That was a lot of effort for me. And my biggest problem as a socially awkward introvert is I don't know how to start conversations with people, but I enjoy the company of other people. And so when I walk into a room and if there's 18 people and they all know each other, they're chopping it up like they go way back, I feel like I'm brought back to junior high again. Like I'm the new kid who just transferred into school and I look like nobody and I feel very much the outsider. What I do is I am a provocateur. So I want to wear things that invite people to have a conversation with me. So they can say, \"Hey, what's up with your hat? Why did you wear this today? And let's have a conversation. Or are you in the creative space? Or you must be doing something. Or you're an important person. I need to talk to you, right?\" I'm like, \"Am I?\" That solves most of my problem. So in social circles, the job, unlike on stage, is come talk to me, please. I'd like to have a conversation with you cuz I think you're a person worth getting to know, but I don't have those skills. You just don't know that's what I'm doing to you. &gt;&gt; I love that. I'm glad to experience it once or twice, so Okay, quick pivot before we wrap this up. 2026, any 2025 reflections of things that happened that you were really happy that it happened last year and things that you want to change for 2026? &gt;&gt; I'm a big believer that everything that happens, good and bad, happens in perfect time in the moment it's supposed to happen. So we had a lot of setbacks last year and it was rough to get through. And we have moved on from some of the key members of our company and they've gone on to do wonderful, amazing things. I'm really happy for them. Shout out to to Ben and Stef, right? They're doing their thing. Super proud, super happy for them. And it meant that we had to like solve some of our own problems because when they took Accelerator with them, they also took a large chunk of revenue away from us and we had to see, can we still do this? Are we still relevant? What are we all about? So, last year was about this idea of like getting really super hyper focused and executing on ideas that we talked about, but we never execute. So, the smaller your team the more work you have to do. Everybody understands that. But, the smaller your team, the less friction there is to do what it is that you want to do. You don't have so many different opinions about what we should and shouldn't do, and then therefore you can just execute on those things. And there's one big thing that's happened last year that that is materialized this year, which is we need office space. And in order for me to acquire more office space I have to get the financials in the company back on track. So, for the past couple years I've been on semi-retirement mode. I work for fun. It's a lifestyle business. As long as we don't lose money, I'm okay. So, my wife comes to me and says, \"I just you know, I have to pull money from our other money-making things to support just our current bills.\" I'm like, \"Okay. How much more money do I need to make?\" She goes, \"Well, $20,000 more a month would probably do it. That's how much short we are.\" I said, \"I can do that.\" And then now I want to acquire property, which means that number's even high and much higher. So, the goal posts just moved, right? So, if I want to maintain our lifestyle, I needed to earn $20,000 more a month so that she's not withdrawing money from other accounts. But, now if I want to acquire a property, I've got to do in orders of magnitude more than that. But, I told her let's get the property. I'm going to get back to work. I've been get myself into the next gear and there are many gears to to the way my mind and my body work, and I've been super hyper focused on doing whatever it takes to get us to that goal. And I realized something really important about myself. I already knew this, but it was just confirmation. I can only be pushed so much. I need to be pulled towards something. So, not having something to pull me the old pull was make enough money so your wife and your family have financial security. This is important. As a provider, I need to do that. And when I shot past that goal, I'm good. So, I didn't feel like I needed to do anything anymore, right? And so, that was okay. So, now I've I've like found a new thing to pull me, which is in order to achieve the next level, I've got to make a certain amount of money. It means I have to get super focused, no more messing around. Let's get work done. So, when I'm ready to make that announcement, everybody will know that's what he was talking about. &gt;&gt; I don't see you as a person that like we hear about you messing around. Like what is messing around for Chris? &gt;&gt; Messing around means something like this. I haven't launched a new product or course in years. I haven't changed a lot of the workshops that I'm doing. I've been refining them. And it also means sometimes I'll do a 6-hour Netflix binge. And my my friends my friend Jewel in particular would say, \"I hate you.\" I'm like, \"What now? Why do you hate me, Jewel?\" And she'll say things like, \"How is it that you can get this thing done, make those posts, manage content, watch TV, figure out the brain raw stuff on Instagram? Like what are you doing in your life that I'm not cuz I could barely show up and get XYZ done?\" I live a highly optimized life. But part of that meant there were long kind of lulls. Like oh, let me go for 4-hour walk or let me just leisurely work out in the gym for 2 hours. I'm literally probably doing 15 minutes of work, but I'm just stretching out for 2 hours cuz I get to enjoy my life. Now I'm like, \"You know what? I got to cut some of this stuff out. I got to be more efficient. Let's get stuff done.\" So, I'm not sitting there on the couch like, \"Oh, let me do 3 hours of YouTube to kind of know what's going on.\" I don't have time for that anymore. So, I'm getting stuff done. And if you think I've been cooking before, you ain't seen nothing yet. &gt;&gt; Okay. So, what are some ways that people want to support and looking to the book, how can we show up for you? &gt;&gt; A lot of different things. So, we have some goals in terms of growing the YouTube channel. You can support us financially by becoming a member. The patron level is one that counts the most, but we appreciate any and everything you do. A lot of people assume, \"Oh, this is free content.\" And that's the relationship we've created for people. It's not free. It's free for you, but it's not free. It costs us money. It costs me money to have you here and the wonderful people and the electricity and just the space to be able to do this. We try our best to give as much value as possible. And if you feel like your life has been transformed, if you've made some kind of money or transformation in your life, give some of it back so that we can do this. Because Annalapae said something to this effect, \"Every dollar you spend is a vote for the world that you want.\" Which means that when you spend money with one organization, in a weird way, you hope the other organization goes away. And if you spend money with guru marketers and scam-a-thons or whatever else you're you're investing in, you're saying, \"Chris, you guys should die. You should burn into oblivion and we'll continue to support the people who are disingenuous and who know how to put their marketing hooks into you and make promises that no one in their right mind can deliver on. We already know this. But yet, they squeeze and you give. &gt;&gt; Mhm. &gt;&gt; I'd like to play the anti-squeeze, which is if you want, just give. If you don't, that's totally cool. &gt;&gt; Where can we get the books, the workbooks? &gt;&gt; Probably just go to future.com. We'll figure out where you can get them. But if you follow me on social at the Chris Do, you'll know because I'll I'm not trying to make it a secret. I'll tell you. &gt;&gt; Anything else for 2026 that is keeping you up at night? &gt;&gt; Nothing keeps me up at night. I sleep really, really well. But I will tell you something. The next chapter of what holds in what's in store for us in 2026, if all comes to fruition, fingers crossed cuz I don't like talking about chickens before they hatch, you're going to say, \"Oh my god, that guy had a dream and he's just making his dreams come true and we get to ride along and be a part of it. Not just from a voyeur point of view, but we get to learn through the whole process. That's what I'm doing. &gt;&gt; Awesome, man. Well, great talking to you as always. &gt;&gt; Thanks for always having me on your show. &gt;&gt; Of course, man. Thanks for having me in the future. I'll see you guys in the next one. &gt;&gt; [music]","uploadedAt":"2026-08-03T13:53:35.770Z","chunks":[{"id":"doc_1785765215770_m53hnx_c0","text":"The human mind once expanded does not shrink back to its original size. And this is like many things. When you find out that these self-imposed rules that you live by are actually just that, self-imposed and not real rules, they're not laws, that you start to be more free. So, if we want to learn more about ourselves, we need to put ourselves in a position where we're explaining to people what it is that we know, think, and believe, &gt;&gt; [music] &gt;&gt; and judging by their reaction. And if you get enough feedback from different types of people, &gt;&gt; [music] &gt;&gt; you might discover something you weren't even aware about yourself. &gt;&gt; Chris. &gt;&gt; Yes, sir. &gt;&gt; Welcome back to the show. &gt;&gt; Appreciate it. &gt;&gt; 2026. Big things happening. You just launched uh a new workbook Unblend Yourself. Tell me a little bit about what inspired that. &gt;&gt; Unblend Yourself comes from philosophically this idea that we have been socialized to blend in, to get along. &gt;&gt; Mhm. &gt;&gt; And depending on what culture you come from, it's stronger in some than others. But we're wearing, in my opinion, a very uh so, for some people, a professional mask. You show up, you say certain things, and you play your cards. You don't try to upset anybody. And then if you do this for long enough, you forget about who you are, what your core beliefs are, and you're or you're afraid to go against the grain. And this is amplified across social media. We are so fearful of saying our thoughts, expressing ourselves in our truest self, dressing the way we want to, cuz we're afraid of the backlash. So, Unblend Yourself is culmination of the last 3 years of research, testing, experimenting in in virtual and in-person, in real life, workshops, where I'm testing concepts to help people figure out this like figure this out for themselves. Like, who were they Who were they meant to be in this lifetime? Who were they when when they thought to themselves when they're 7 years old, this is what I want to be when I grow up, and something happened to that plan. &gt;&gt; Mhm. Like, did you always have the thought of making this book versus like a sales book, or like how did this come together? &gt;&gt; I realized that my ability to teach as many people as I want is finite if I do it as an in-person experience or even through through the price barrier. But, I believe this is fundamental to our overall well-being, our sense of self. I want to be able to do something that's a standalone thing that can be done at your own pace in the privacy and comfort of your own home that you can go through and ask yourself these deeply personal and profound questions that require a really kind of contemplative reflective moment. And, it's not always conducive to do around people on a certain","t0":0,"t1":200,"tsReal":false,"tfIdfVector":{"2026":0.051464547251475895,"human":0.03758698008090765,"mind":0.03925480231058657,"once":0.03415135910013397,"expanded":0.06070086274254629,"shrink":0.06070086274254629,"back":0.05670132917967449,"original":0.04941046068518941,"size":0.051464547251475895,"like":0.09971832225109861,"many":0.049830087218127136,"things":0.07126680233479409,"find":0.03839481447644119,"self":0.15701920924234627,"imposed":0.12140172548509258,"rules":0.08677534918240874,"live":0.041161647748284035,"actually":0.034771246987012915,"just":0.0329164019695771,"real":0.06385066451442727,"re":0.1338004436913679,"laws":0.06070086274254629,"start":0.029581556313292675,"free":0.04465770051769266,"want":0.11093059927561451,"learn":0.03925480231058657,"ourselves":0.14289338990253478,"need":0.029158498985370786,"put":0.029158498985370786,"position":0.06070086274254629,"where":0.04642328017146587,"explaining":0.06070086274254629,"people":0.11587057728409778,"know":0.018728084762159272,"think":0.021006129315464393,"believe":0.07365066710659879,"gt":0.5945496432128398,"music":0.054447843239510574,"judging":0.06070086274254629,"reaction":0.051464547251475895,"enough":0.07220975548671926,"feedback":0.06070086274254629,"different":0.027964400253229674,"types":0.06070086274254629,"discover":0.051464547251475895,"something":0.06168574588896324,"weren":0.053894016008763056,"even":0.049231177224820136,"aware":0.051464547251475895,"yourself":0.152351156600502,"chris":0.036825333553299394,"yes":0.034771246987012915,"sir":0.066103760