// ------------------------------------------------------------------
// USER PLAYER SELECTION
// ------------------------------------------------------------------
function autoSelectUser(){
  if(watchOn){ userControlled = null; return; }   // WATCH: AI drives the whole YOU team
  if(performance.now() < userLockUntil && userControlled) return;
  let best=null, bd=1e9;
  for(const p of players){
    if(p.team!=='you' || p.gk) continue;
    const d=(p.x-ball.x)**2+(p.y-ball.y)**2;
    if(d<bd){ bd=d; best=p; }
  }
  if(best) userControlled = best;
}
function manualSwitch(){
  const outfield = players.filter(p=>p.team==='you' && !p.gk);
  if(!outfield.length) return;
  let idx = outfield.indexOf(userControlled);
  idx = (idx+1) % outfield.length;
  userControlled = outfield[idx];
  userLockUntil = performance.now() + 1500;
}

// ------------------------------------------------------------------
// KICK / CHARGE
// ------------------------------------------------------------------
// ── STRIKE THE BALL: one weighted model used by shots, passes and clears. ──
// speed = target units/second, spin = signed curve (±). Carries a little of the
// striker's own momentum so a running strike is livelier than a standing one.
function strikeBall(p, dirX, dirY, speed, spin){
  const mag = Math.hypot(dirX,dirY)||1;
  const ux = dirX/mag, uy = dirY/mag;
  // push the ball just off the boot first so it never starts inside the body
  ball.x = p.x + ux*(p.r+ball.r+2);
  ball.y = p.y + uy*(p.r+ball.r+2);
  ball.vx = ux*speed + p.vx*0.14;
  ball.vy = uy*speed + p.vy*0.14;
  ball.spin = spin||0;
  ball.owner = null; ballOwner = null;
  ownerGrace = 0.22;                 // brief window so the striker can't instantly re-trap
  p.kickAnim = 0.22; p.face = Math.atan2(uy, ux);
  spawnKickParticles(ball.x, ball.y, p.color);
}
// Find a human-pass target: a teammate ahead in the aimed direction, leading their run.
function humanPassTarget(p, aimX, aimY){
  const amag = Math.hypot(aimX,aimY)||1; const ax=aimX/amag, ay=aimY/amag;
  let best=null, bestScore=-1e9;
  for(const m of players){
    if(m===p || m.team!==p.team || m.gk) continue;
    const dx=m.x-p.x, dy=m.y-p.y, dist=Math.hypot(dx,dy);
    if(dist<45 || dist>460) continue;
    const along = (dx*ax+dy*ay);              // projection onto aim
    if(along < 40) continue;                   // must be broadly where we're aiming
    const off = Math.abs(dx*(-ay)+dy*ax);      // perpendicular distance from the aim line
    const cone = off/Math.max(1,along);        // tan of angle from aim
    if(cone > 0.6) continue;                    // ~31° cone
    const score = along - off*1.4 - dist*0.15;
    if(score>bestScore){ bestScore=score; best=m; }
  }
  return best;
}
function releaseKick(){
  if(state!=='play' || !userControlled){ charging=false; charge=0; return; }
  const p = userControlled;
  const d = Math.hypot(ball.x-p.x, ball.y-p.y);
  const canStrike = (d < p.r + ball.r + KICK_REACH) && p.kickCd<=0 && (ballOwner===p || !ballOwner || ballOwner.team===p.team);
  // If a rival is carrying and we're close, the kick key becomes a TACKLE.
  if(ballOwner && ballOwner.team!==p.team && Math.hypot(ball.x-p.x,ball.y-p.y) < p.r+ball.r+18){
    if(tryTackle(p)) { charging=false; charge=0; return; }
  }
  if(canStrike){
    const enemyGoalX = p.team==='you' ? FIELD.w : 0;
    let steerX = keyDirX(), steerY = keyDirY();
    const steering = (steerX!==0 || steerY!==0);
    const pw = getEffectiveStat(p.power, p.team, 'power');
    const ctl = getEffectiveStat(p.control, p.team, 'control');
    const surgeMul = p.surgeT>0 ? SURGE_PWR_MUL : 1;

    // Short tap (barely charged) while steering toward a teammate = a crisp PASS.
    const mate = steering ? humanPassTarget(p, steerX, steerY) : null;
    if(mate && charge < 0.55){
      // ground pass that LEADS the receiver's run
      const lx = mate.x + mate.vx*0.14, ly = mate.y + mate.vy*0.14;
      const dist = Math.hypot(lx-p.x, ly-p.y);
      // weight scales with distance so short passes aren't rockets, long balls still arrive
      let speed = (110 + dist*0.55 + charge*105) * (0.9 + pw*0.22) * surgeMul;
      speed = Math.min(speed, 360);
      strikeBall(p, lx-p.x, ly-p.y, speed, 0);
      p.kickCd = 0.24;
    } else {
      // SHOT / CLEAR. Aim where you steer; if not steering, aim-assist to an open corner.
      let ax, ay;
      if(steering){ ax = steerX; ay = steerY; }
      else { const aim = aimAssistToGoal(p); ax = aim.x; ay = aim.y; }
      // curve: lateral steer relative to the goal line bends the shot (banana)
      let spin = 0;
      const toGoalX = enemyGoalX - p.x;
      if(Math.sign(ax)===Math.sign(toGoalX) || !steering){
        // curl toward the near side you're leaning — feels intentional
        spin = (steerY!==0 ? steerY : 0) * (0.9*ctl) ;
      }
      let speed = (195 + charge*300) * (0.78 + pw*0.5) * surgeMul;
      speed = Math.min(speed, 470);
      strikeBall(p, ax, ay, speed, spin);
      p.kickCd = 0.30;
    }
  }
  charging=false; charge=0;
}
function keyDirX(){ return (keys['a']||keys['arrowleft']?-1:0)+(keys['d']||keys['arrowright']?1:0); }
function keyDirY(){ return (keys['w']||keys['arrowup']?-1:0)+(keys['s']||keys['arrowdown']?1:0); }

// ── CAPTAIN SPECIAL: "SURGE" — a burst of pace + power for a short window, on a
// cooldown. Mirrors the dodgeball OVERDRIVE pattern (shake/flash/particles + HUD).
function findTeamCaptain(team){
  for(const p of players){ if(p.team===team && p.isCaptain && !p.gk) return p; }
  return null;
}
function activateSurge(p){
  if(!p || p.gk || !p.isCaptain || p.capCd>0 || p.surgeT>0) return;
  p.surgeT = SURGE_TIME;
  p.capCd  = SURGE_COOLDOWN;
  p.surgeFlash = 0.5;
  shake = Math.max(shake, 14);
  // burst particles in the team color (respect the cap)
  spawnKickParticles(p.x, p.y, p.color);
  let n=10; if(particles.length+n>MAX_PARTICLES) n=Math.max(0, MAX_PARTICLES-particles.length);
  for(let i=0;i<n;i++){
    const a=Math.random()*Math.PI*2, s=2+Math.random()*4;
    particles.push({x:p.x,y:p.y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:0.5+Math.random()*0.4,color:p.color});
  }
}
// human trigger (Q): drive the YOU-team captain's surge even if not the active player
function doCaptainSurge(){
  const cap = findTeamCaptain('you');
  if(cap){ activateSurge(cap); }
}

// ------------------------------------------------------------------
// AI
// ------------------------------------------------------------------
// Which team is in possession right now (nearest outfielder within touch range)?
function possessionTeam(){
  let best=null, bd=44*44;
  for(const p of players){
    if(p.gk) continue;
    const d=(p.x-ball.x)**2+(p.y-ball.y)**2;
    if(d<bd){ bd=d; best=p; }
  }
  return best ? best.team : null;
}

function aiUpdate(dt){
  // find nearest to ball per team (the "active" chaser)
  const chaser = {};
  ['you','opp'].forEach(t=>{
    let best=null,bd=1e9;
    for(const p of players){
      if(p.team!==t || p.gk) continue;
      if(t==='you' && p===userControlled) continue;
      const d=(p.x-ball.x)**2+(p.y-ball.y)**2;
      if(d<bd){bd=d;best=p;}
    }
    chaser[t]=best;
  });
  const posTeam = possessionTeam();

  for(const p of players){
    if(p===userControlled) continue; // user drives this one
    let tx=p.home.x, ty=p.home.y;
    const attackDir = p.team==='you' ? 1 : -1;
    const ownGoalX = p.team==='you' ? 0 : FIELD.w;
    const enemyGoalX = p.team==='you' ? FIELD.w : 0;
    const weAttack = (posTeam===p.team);

    // ── CAPTAIN SURGE (AI): fire when it changes the play — chasing a loose ball,
    // breaking clear on the counter, or defending a fast attack. Re-checked on a timer.
    if(p.isCaptain && !p.gk){
      p.aiSurgeCd -= dt;
      if(p.aiSurgeCd<=0 && p.capCd<=0 && p.surgeT<=0){
        p.aiSurgeCd = 1.2 + Math.random()*1.6;
        const ballDist0 = Math.hypot(ball.x-p.x, ball.y-p.y);
        const inFinalThird = (attackDir>0) ? p.x>FIELD.w*0.62 : p.x<FIELD.w*0.38;
        const looseNear = (!posTeam && ballDist0<220);
        const breakingClear = (weAttack && p===chaser[p.team] && inFinalThird);
        const chaseBack = (!weAttack && p===chaser[p.team] && ballDist0<260);
        if(looseNear || breakingClear || chaseBack){ activateSurge(p); }
      }
    }

    if(p.gk){
      // keeper: hold the line, read the ball's path, come out to narrow the angle,
      // and dive to the predicted crossing point so shots aren't free goals.
      tx = ownGoalX + attackDir*40;
      // predict where the ball crosses the goal line (time = horizontal dist / vx)
      let predictY = ball.y;
      const towardUs = (attackDir>0) ? ball.vx<-20 : ball.vx>20;
      if(towardUs){
        const t = Math.abs((ownGoalX - ball.x)/ball.vx);
        predictY = ball.y + ball.vy*Math.min(t,0.6);
        // reaction imperfection: keeper can't read a well-placed shot perfectly,
        // so corner-bound shots have a real chance to beat it.
        predictY += (Math.random()-0.5)*46;
      } else {
        predictY = ball.y + ball.vy*0.08; // gentle shade to live ball
      }
      ty = Math.max(goalTop+8, Math.min(goalBot-8, predictY));
      const gkDist = Math.hypot(ball.x-p.x, ball.y-p.y);
      // rush out to smother when the ball is close and loose/incoming
      if(gkDist < 120 && (attackDir>0 ? ball.x < FIELD.w*0.2 : ball.x > FIELD.w*0.8)){
        ty = predictY; tx = ownGoalX + attackDir*(gkDist<55?22:38);
      }
      moveToward(p, tx, ty, dt, 0.82);
      // clear the ball upfield toward an open flank
      if(gkDist < p.r+ball.r+KICK_REACH && p.kickCd<=0){
        const flankY = p.y < FIELD.h/2 ? FIELD.h*0.72 : FIELD.h*0.28;
        strikeBall(p, enemyGoalX-p.x, flankY-p.y, 400, 0);
        p.kickCd=0.5;
      }
      continue;
    }

    const iAmChaser = (p===chaser[p.team]);
    const ballDist = Math.hypot(ball.x-p.x, ball.y-p.y);

    if(iAmChaser){
      // intercept the ball — lead its motion so we run onto it, not behind it.
      const bs0 = Math.hypot(ball.vx,ball.vy);
      const lead = Math.min(0.28, 40/(bs0+40)); // more lead when the ball is slow/nearby
      tx = ball.x + ball.vx*lead; ty = ball.y + ball.vy*lead;
      const surgeMul = p.surgeT>0 ? SURGE_PWR_MUL : 1;
      const ctl = getEffectiveStat(p.control,p.team,'control');
      const pw  = getEffectiveStat(p.power, p.team, 'power');
      const carrying = (ballOwner===p);
      if((carrying || ballDist < p.r+ball.r+KICK_REACH) && p.kickCd<=0){
        const gy = goalTop + GOAL_H*0.5;
        const distGoal = Math.abs(enemyGoalX - p.x);
        const mate = bestPassTarget(p, enemyGoalX, attackDir);
        // pressure: nearest rival to us
        let press = 1e9;
        for(const o of players){ if(o.team===p.team||o.gk) continue;
          const od=Math.hypot(o.x-p.x,o.y-p.y); if(od<press) press=od; }
        const pressured = press < 60;
        const shootRange = distGoal < 360;
        if(shootRange && (!pressured || !mate || Math.random()<0.5)){
          // SHOOT — aim into a corner, tighter with more control; surge = laser.
          const spread = (GOAL_H-56) * (1 - ctl*0.45);
          const aimY = gy + (Math.random()-0.5)*spread;
          const spin = ((aimY - p.y)>0?1:-1) * (Math.random()*0.5) * ctl;
          const speed = (335 + pw*140) * surgeMul;
          strikeBall(p, enemyGoalX-p.x, aimY-p.y, Math.min(speed,470), spin);
          p.kickCd = 0.44;
        } else if(mate){
          // PASS — lead the receiver's run, weighted to distance.
          const lx = mate.x + mate.vx*0.16, ly = mate.y + mate.vy*0.16;
          const dist = Math.hypot(lx-p.x, ly-p.y);
          const speed = Math.min(360, (130 + dist*0.6) * surgeMul);
          strikeBall(p, lx-p.x, ly-p.y, speed, 0);
          p.kickCd = 0.3;
        } else {
          // DRIBBLE — take a controlled touch toward goal (close control keeps it near).
          const touch = (100 + (1-ctl)*45) * surgeMul;
          const ang = Math.atan2((gy-p.y)*0.35, attackDir);
          strikeBall(p, attackDir, (gy-p.y)*0.4, touch, 0);
          ballOwner = p;                 // keep close control after the touch
          p.kickCd = 0.14;
        }
      }
      moveToward(p, tx, ty, dt, 1.12);
      if(!carrying && ballOwner && ballOwner.team!==p.team) tryTackle(p);
    } else if(weAttack){
      // ATTACKING SHAPE: break into space and spread across the pitch for options.
      // Fan out around the carrier so we always offer a forward + a wide passing lane.
      const spreadY = (p.home.y - FIELD.h/2);          // keep vertical spacing from home role
      tx = ball.x + attackDir*(120 + (p.home.x-FIELD.w/2)*0.15);
      ty = ball.y*0.5 + (FIELD.h/2 + spreadY*1.15)*0.5;
      // don't clog the carrier's exact spot — push off if too close
      const dxc = p.x-ball.x, dyc = p.y-ball.y, dc=Math.hypot(dxc,dyc);
      if(dc>0 && dc<70){ tx += (dxc/dc)*40; ty += (dyc/dc)*40; }
      moveToward(p, tx, ty, dt, 0.82);
    } else {
      // DEFENDING SHAPE: compact block goal-side of the ball; the second-nearest
      // defender steps up to PRESS the carrier, the rest hold a line and cover.
      const secondPresser = isSecondNearest(p, chaser[p.team]);
      if(secondPresser && ballDist < 300){
        // press: close down the carrier, staying slightly goal-side
        tx = ball.x + (ownGoalX - ball.x)*0.12;
        ty = ball.y + (p.home.y - ball.y)*0.2;
        moveToward(p, tx, ty, dt, 1.05);
        tryTackle(p);   // steal it if we get tight to a rival carrier
      } else {
        // hold a compact defensive block, shade to ball y, sit goal-side
        tx = p.home.x*0.42 + (ownGoalX + attackDir*185)*0.58;
        ty = p.home.y*0.5 + ball.y*0.5;
        moveToward(p, tx, ty, dt, 0.8);
      }
    }
  }
}
// true if p is the 2nd-nearest outfielder on its team to the ball (the presser),
// given the nearest (chaser) is already committed.
function isSecondNearest(p, chaser){
  if(p===chaser) return false;
  let bd=1e9, best=null;
  for(const q of players){
    if(q.team!==p.team || q.gk || q===chaser) continue;
    const d=(q.x-ball.x)**2+(q.y-ball.y)**2;
    if(d<bd){ bd=d; best=q; }
  }
  return best===p;
}

// STANDING TACKLE: a close-range poke that dislodges the ball from a rival carrier.
// Success scales with the tackler's control vs the carrier's control (contested, fair).
function tryTackle(p){
  if(p.gk || p.tackleCd>0) return false;
  const carrier = ballOwner;
  const targetIsCarrier = carrier && carrier.team!==p.team;
  const bd = Math.hypot(ball.x-p.x, ball.y-p.y);
  if(bd > p.r+ball.r+16) return false;         // must be tight to the ball
  p.tackleCd = 0.45;                            // can't spam
  const myCtl = getEffectiveStat(p.control,p.team,'control') + (p.team==='you'?skillBoosts.defense*0.6:0);
  if(targetIsCarrier){
    const carCtl = getEffectiveStat(carrier.control,carrier.team,'control');
    const win = 0.34 + (myCtl-carCtl)*0.6;      // ~34% base, tilted by control gap (lets attacks build)
    if(Math.random() < win){
      // knock the ball toward the tackler / into space ahead of them
      const ang = Math.atan2((p.y-carrier.y), (p.x-carrier.x)) + (Math.random()-0.5)*0.5;
      ball.vx = Math.cos(ang)*100 + p.vx*0.3;
      ball.vy = Math.sin(ang)*100 + p.vy*0.3;
      ball.owner=null; ballOwner=null; ownerGrace=0.12; carrier.kickCd=0.3;
      spawnKickParticles(ball.x, ball.y, p.color);
      shake = Math.max(shake, 6);
      return true;
    }
    return false;
  }
  // loose ball right at our feet: gather it
  if(!carrier && Math.hypot(ball.vx,ball.vy) < TRAP_SPEED){ ballOwner = p; return true; }
  return false;
}

function moveToward(p, tx, ty, dt, spdMul){
  const dx=tx-p.x, dy=ty-p.y;
  const d=Math.hypot(dx,dy)||1;
  const acc = 580 * spdMul * (0.7 + getEffectiveStat(p.speed, p.team, 'speed')*0.6);
  if(d>4){
    p.vx += (dx/d)*acc*dt;
    p.vy += (dy/d)*acc*dt;
  }
}
// AIM ASSIST: return a unit-ish vector toward the best-open corner of the enemy goal.
// Picks whichever post the keeper is furthest from, so an idle-direction kick still
// threatens the goal. Used for the human kick when no steering key is held.
function aimAssistToGoal(p){
  const enemyGoalX = p.team==='you' ? FIELD.w : 0;
  const gk = players.find(o=>o.team!==p.team && o.gk);
  const topC = goalTop + 26, botC = goalBot - 26;
  // aim away from the keeper's y; if no keeper, aim at whichever corner is nearer p's line
  let aimY;
  if(gk){ aimY = (Math.abs(gk.y-topC) >= Math.abs(gk.y-botC)) ? topC : botC; }
  else { aimY = (p.y < (goalTop+goalBot)/2) ? topC : botC; }
  return { x: enemyGoalX - p.x, y: aimY - p.y };
}

// Pick a teammate who is clearly further up the pitch and reasonably open (no rival
// tight to the passing lane). Returns null if dribbling/shooting is better.
function bestPassTarget(p, enemyGoalX, attackDir){
  let best=null, bestScore=0;
  for(const m of players){
    if(m===p || m.team!==p.team || m.gk) continue;
    const forward = (m.x - p.x)*attackDir;       // how much further up-pitch
    if(forward < 55) continue;                    // only forward passes
    const dist = Math.hypot(m.x-p.x, m.y-p.y);
    if(dist < 60 || dist > 420) continue;
    // openness: nearest rival to the receiver
    let tight = 1e9;
    for(const o of players){ if(o.team===p.team) continue;
      const od=Math.hypot(o.x-m.x, o.y-m.y); if(od<tight) tight=od; }
    if(tight < 46) continue;                       // marked → not a good option
    const score = forward*1.2 + tight*0.4 - Math.abs(m.y-p.y)*0.2;
    if(score>bestScore){ bestScore=score; best=m; }
  }
  return best;
}

// ------------------------------------------------------------------
// PHYSICS UPDATE
// ------------------------------------------------------------------
function update(dt){
  // timer only runs during play
  if(state==='play'){
    timeLeft -= dt;
    if(timeLeft<=0){ timeLeft=0; endMatch(); return; }
  }

  // charge build
  if(state==='play' && (keys[' ']||keys['j']) && userControlled){
    charging=true;
    charge = Math.min(1, charge + dt*1.4);
  }

  // AI
  if(state==='play') aiUpdate(dt);

  // USER movement
  if(state==='play' && userControlled){
    const p=userControlled;
    let dx=keyDirX(), dy=keyDirY();
    const mag=Math.hypot(dx,dy);
    const sprinting = (keys['shift']) && stamina>0.02 && mag>0;
    const baseAcc = 950 * (0.7 + getEffectiveStat(p.speed, p.team, 'speed')*0.6);
    const acc = baseAcc * (sprinting?1.75:1.0) * (p.surgeT>0?1.4:1.0);
    if(mag>0){ p.vx += dx/mag*acc*dt; p.vy += dy/mag*acc*dt; }
    // stamina: 'engine' skill drains slower and recovers faster (YOU team)
    const stamMul = 1 + getEffectiveStat(0, p.team, 'stamina'); // 1 + boost
    if(sprinting){ stamina = Math.max(0, stamina - dt*0.45/stamMul); }
    else { stamina = Math.min(1, stamina + dt*0.28*stamMul); }
  }

  // integrate players
  // TEMPO: player top speed reduced to ~63% of the old 260 for a calmer, readable pace.
  const maxSpeed = 164;
  for(const p of players){
    if(p.kickCd>0) p.kickCd-=dt;
    if(p.tackleCd>0) p.tackleCd-=dt;
    if(p.kickAnim>0) p.kickAnim-=dt;
    if(p.capCd>0) p.capCd-=dt;
    if(p.surgeT>0) p.surgeT-=dt;
    if(p.surgeFlash>0) p.surgeFlash-=dt;
    // friction
    p.vx *= 0.86; p.vy *= 0.86;
    const sp=Math.hypot(p.vx,p.vy);
    let cap = maxSpeed*(0.75+getEffectiveStat(p.speed, p.team, 'speed')*0.5);
    if(p===userControlled && keys['shift'] && stamina>0.02) cap*=1.35;
    if(p.surgeT>0) cap*=SURGE_SPD_MUL;   // captain SURGE burst of pace
    if(sp>cap){ p.vx=p.vx/sp*cap; p.vy=p.vy/sp*cap; }
    p.x += p.vx*dt; p.y += p.vy*dt;
    // bounds
    p.x=Math.max(p.r, Math.min(FIELD.w-p.r, p.x));
    p.y=Math.max(p.r, Math.min(FIELD.h-p.r, p.y));
    // facing + run-cycle animation (cartoon body)
    if(sp>18){ p.face = Math.atan2(p.vy, p.vx); p.anim += dt*(6 + sp*0.03); }
    else { p.anim += dt*1.2; }
    // trail
    p.trail.push({x:p.x,y:p.y});
    if(p.trail.length>8) p.trail.shift();
  }

  // player-player collision (simple push)
  for(let i=0;i<players.length;i++){
    for(let j=i+1;j<players.length;j++){
      const a=players[i], b=players[j];
      const dx=b.x-a.x, dy=b.y-a.y; let d=Math.hypot(dx,dy);
      const min=a.r+b.r;
      if(d<min && d>0){
        const ov=(min-d)/2, nx=dx/d, ny=dy/d;
        a.x-=nx*ov; a.y-=ny*ov; b.x+=nx*ov; b.y+=ny*ov;
        const tmpx=a.vx*0.4, tmpy=a.vy*0.4;
        a.vx=b.vx*0.4; a.vy=b.vy*0.4; b.vx=tmpx; b.vy=tmpy;
      }
    }
  }

  // ── BALL PHYSICS (dt-integrated, units/second) ──
  if(ownerGrace>0) ownerGrace-=dt;
  // if the current owner strayed (got tackled / ball kicked away), drop ownership
  if(ballOwner){
    const od = Math.hypot(ball.x-ballOwner.x, ball.y-ballOwner.y);
    if(ballOwner.gk || od > ballOwner.r+ball.r+34) ballOwner = null;
  }

  if(ballOwner){
    // CLOSE CONTROL / DRIBBLE — the carrier keeps the ball just ahead of their feet.
    const p = ballOwner;
    const sp = Math.hypot(p.vx,p.vy);
    let dirx = p.vx, diry = p.vy;
    if(sp < 8){ dirx = Math.cos(p.face); diry = Math.sin(p.face); }     // stand still: hold it in front
    const dm = Math.hypot(dirx,diry)||1; dirx/=dm; diry/=dm;
    const sprinting = (p===userControlled && keys['shift'] && stamina>0.02) || p.surgeT>0;
    const gap = p.r + ball.r + (sprinting ? DRIBBLE_SPRINT_GAP : DRIBBLE_GAP);
    const tX = p.x + dirx*gap, tY = p.y + diry*gap;
    // spring the ball toward the control point — responsive but not glued/teleporty
    const follow = Math.min(1, dt*22);
    ball.x += (tX-ball.x)*follow;
    ball.y += (tY-ball.y)*follow;
    ball.vx = p.vx; ball.vy = p.vy; ball.spin = 0;
    ball.face = p.face;
  } else {
    // LOOSE BALL — roll with weighty friction; curve if it has spin.
    let sp = Math.hypot(ball.vx,ball.vy);
    if(sp>0){
      // curve (magnus): accel perpendicular to travel, scaled by spin
      if(Math.abs(ball.spin)>0.01){
        const nx=-ball.vy/sp, ny=ball.vx/sp;
        ball.vx += nx*ball.spin*BALL_SPIN_FORCE*dt;
        ball.vy += ny*ball.spin*BALL_SPIN_FORCE*dt;
        ball.spin -= ball.spin*Math.min(1,BALL_SPIN_DECAY*dt);
      }
      // rolling friction: decelerate proportional to speed (weighty, natural)
      const dec = BALL_FRICTION*dt;
      const nsp = Math.max(0, sp - dec*sp - 0.4*dec*Math.sqrt(sp));
      if(nsp<=BALL_MIN_SPEED){ ball.vx=0; ball.vy=0; ball.spin=0; }
      else { const k=nsp/sp; ball.vx*=k; ball.vy*=k; }
    }
    // clamp
    sp = Math.hypot(ball.vx,ball.vy);
    if(sp>BALL_MAX_SPEED){ const k=BALL_MAX_SPEED/sp; ball.vx*=k; ball.vy*=k; }
    ball.x += ball.vx*dt; ball.y += ball.vy*dt;
  }

  // trail
  ball.trail.push({x:ball.x,y:ball.y});
  if(ball.trail.length>12) ball.trail.shift();

  // ── BALL vs PLAYERS: trap loose balls, or carom off bodies cleanly (no stick/jitter) ──
  if(!ballOwner){
    // pick the closest player within trap reach who is eligible to gather it
    let trapper=null, tbd=1e9;
    for(const p of players){
      if(ownerGrace>0 && p.kickCd>0) continue;               // striker's brief no-retrap window
      const d=Math.hypot(ball.x-p.x, ball.y-p.y);
      const reach = p.r+ball.r+ (p===userControlled? TRAP_RANGE : (p.gk?18:14));
      if(d<reach && d<tbd){ tbd=d; trapper=p; }
    }
    const bs = Math.hypot(ball.vx,ball.vy);
    if(trapper){
      const facingOk = true;
      if(bs <= TRAP_SPEED){
        // FIRST TOUCH — gather it under control (spring handles positioning next frame)
        if(!(trapper===userControlled && charging)){
          ballOwner = trapper;
        }
      } else {
        // too hot to trap: a deflected first touch that kills some pace, stays near
        const d=Math.hypot(ball.x-trapper.x,ball.y-trapper.y)||1;
        const nx=(ball.x-trapper.x)/d, ny=(ball.y-trapper.y)/d;
        ball.x=trapper.x+nx*(trapper.r+ball.r+2); ball.y=trapper.y+ny*(trapper.r+ball.r+2);
        const rel=ball.vx*nx+ball.vy*ny;
        const ctl=getEffectiveStat(trapper.control,trapper.team,'control');
        const keep = 0.28 - ctl*0.12;            // better control = softer, closer deflection
        ball.vx = (ball.vx - rel*nx)*0.5 + nx*bs*keep*0.3 + trapper.vx*0.2;
        ball.vy = (ball.vy - rel*ny)*0.5 + ny*bs*keep*0.3 + trapper.vy*0.2;
        ball.spin*=0.4;
      }
    } else {
      // no one gathering — resolve any body overlap as a clean bounce
      for(const p of players){
        const dx=ball.x-p.x, dy=ball.y-p.y; let d=Math.hypot(dx,dy);
        const min=p.r+ball.r;
        if(d<min && d>0){
          const nx=dx/d, ny=dy/d;
          ball.x=p.x+nx*min; ball.y=p.y+ny*min;
          const rel=ball.vx*nx+ball.vy*ny;
          if(rel<0){ // moving into the body → reflect
            ball.vx -= (1+BALL_PLAYER_BOUNCE)*rel*nx;
            ball.vy -= (1+BALL_PLAYER_BOUNCE)*rel*ny;
          }
          ball.vx += p.vx*0.25; ball.vy += p.vy*0.25;   // carry some of the body's motion
          ball.spin*=0.5;
        }
      }
    }
  }

  // walls & goals
  handleBallBounds();

  // celebrate countdown
  if(state==='celebrate'){
    celebrateTimer -= dt;
    if(celebrateTimer<=0){ resetKickoff(); state='play'; }
  }

  // update user selection
  if(state==='play') autoSelectUser();

  // particles (field-space, dt-integrated)
  for(let i=particles.length-1;i>=0;i--){
    const pt=particles[i];
    pt.fx+=pt.vx*dt; pt.fy+=pt.vy*dt; pt.vx*=0.90; pt.vy*=0.90; pt.life-=dt;
    if(pt.life<=0) particles.splice(i,1);
  }
  for(let i=confetti.length-1;i>=0;i--){
    const c=confetti[i];
    c.x+=c.vx; c.y+=c.vy; c.vy+=0.15; c.rot+=c.vr; c.life-=dt;
    if(c.life<=0) confetti.splice(i,1);
  }

  // shake decay
  if(shake>0){ shake=Math.max(0,shake-dt*38); }

  // camera smoothing
  updateCamera(dt);
}

function handleBallBounds(){
  const topWall = 0, botWall = FIELD.h, leftWall=0, rightWall=FIELD.w;
  const R=BALL_WALL_BOUNCE;
  if(ball.y-ball.r<topWall){ ball.y=topWall+ball.r; ball.vy=-ball.vy*R; ball.spin*=0.6; if(ballOwner)ballOwner=null; }
  if(ball.y+ball.r>botWall){ ball.y=botWall-ball.r; ball.vy=-ball.vy*R; ball.spin*=0.6; if(ballOwner)ballOwner=null; }
  // left side: goal region or wall
  if(ball.x-ball.r<leftWall){
    if(ball.y>goalTop && ball.y<goalBot){ goal('opp'); return; }
    else { ball.x=leftWall+ball.r; ball.vx=-ball.vx*R; ball.spin*=0.6; if(ballOwner)ballOwner=null; }
  }
  // right side: goal region or wall
  if(ball.x+ball.r>rightWall){
    if(ball.y>goalTop && ball.y<goalBot){ goal('you'); return; }
    else { ball.x=rightWall-ball.r; ball.vx=-ball.vx*R; ball.spin*=0.6; if(ballOwner)ballOwner=null; }
  }
}

// ------------------------------------------------------------------
// GOAL
// ------------------------------------------------------------------
function goal(scorer){
  if(state==='celebrate') return;
  if(scorer==='you'){ scoreYou++; celebrateText='GOAL!'; celebrateColor=selectedAgent.color; }
  else { scoreOpp++; celebrateText='CONCEDED'; celebrateColor='#ff5a7a'; }
  state='celebrate';
  celebrateTimer = 1.8;
  shake = 22;
  ball.vx*=0.2; ball.vy*=0.2; ball.spin=0; ballOwner=null;
  spawnConfetti(scorer==='you'?selectedAgent.color:'#ff5a7a');
}

function endMatch(){
  state='fulltime';
  const rs=document.getElementById('resultScreen');
  const rt=document.getElementById('resultTitle');
  const rsc=document.getElementById('resultScore');
  const rsub=document.getElementById('resultSub');
  rsc.textContent = `${scoreYou} — ${scoreOpp}`;
  rt.style.webkitBackgroundClip='unset'; rt.style.backgroundClip='unset'; rt.style.background='none';
  rt.style.textShadow='0 0 40px currentColor';
  if(scoreYou>scoreOpp){ rt.textContent='VICTORY'; rt.style.color='#38ffb0'; rsub.textContent='CHAMPIONS OF THE COUNCIL CUP'; spawnConfetti(selectedAgent.color); }
  else if(scoreYou<scoreOpp){ rt.textContent='DEFEAT'; rt.style.color='#ff5a7a'; rsub.textContent='REGROUP AND RUN IT BACK'; }
  else { rt.textContent='DRAW'; rt.style.color='#ffd35c'; rsub.textContent='EVENLY MATCHED'; }
  rs.classList.remove('hidden');
  document.getElementById('pauseHint').classList.add('hidden');
  document.body.classList.remove('playing');
  postScore(scoreYou);
}

